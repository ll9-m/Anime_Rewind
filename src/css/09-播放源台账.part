/* ============================================================
   播放源台账
   ============================================================ */
/* 汇总条：数字用等宽字体对齐，语义色只给「有问题」的那几个。
   全绿的一排绿块等于没有重点 —— 台账要回答的是
   「哪里出问题了」，不是「一切正常」。 */
.ledger-stats{ display:flex; flex-wrap:wrap; gap:var(--sp-2); margin-bottom:var(--sp-4); }
.ledger-stat{
  flex:1 1 116px; min-width:104px; padding:var(--sp-3);
  background:var(--panel); border:1px solid var(--border);
  border-left:2px solid var(--border-2); border-radius:var(--r-md);
}
.ledger-stat b{
  display:block; font-family:var(--font-mono); font-size:var(--fs-xl);
  line-height:1.2; letter-spacing:-.01em;
}
.ledger-stat span{ font-size:11px; color:var(--muted); }
.ledger-stat.tone-ok{ border-left-color:var(--ok); }
.ledger-stat.tone-ok b{ color:var(--ok); }
.ledger-stat.tone-warn{ border-left-color:var(--warn); }
.ledger-stat.tone-warn b{ color:var(--warn); }
.ledger-stat.tone-err{ border-left-color:var(--danger); }
.ledger-stat.tone-err b{ color:var(--danger); }

/* 台账表：行内操作密集，密度比片库表格更紧一档 */
.ledger-table .col-check{ width:34px; }
/* 搜索框要比片库那条更宽：这里的placeholder 有五项提示词，
   沿用片库的 200px 会被截成「片名 / 线路名 / 网址 / 站点 /」，
   用户根本猜不到还能搜什么。 */
.ledger-q{ flex:1 1 320px; min-width:260px; }
.ledger-q .search-wrap{ max-width:none; }
.ledger-table .col-src{ min-width:200px; }
.ledger-table .url-cell{
  display:block; font-family:var(--font-mono); font-size:11px; color:var(--muted);
  max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}
.ledger-table tr.is-dead td:not(.col-check){ opacity:.62; }
.ledger-table tr.is-dead .url-cell{ text-decoration:line-through; }
/* 被勾选的行要整行有反馈，否则用户不知道批量操作会作用在哪些行上 */
.ledger-table tr.is-picked{ background:var(--accent-soft); }
.ledger-table .flag-row{ display:flex; gap:4px; flex-wrap:wrap; }
.flag{
  display:inline-flex; align-items:center; padding:0 5px; border-radius:var(--r-sm);
  font-size:10.5px; font-weight:600; border:1px solid currentColor; white-space:nowrap; line-height:1.6;
}
.flag.tone-ok{ color:var(--ok); }
.flag.tone-warn{ color:var(--warn); }
.flag.tone-err{ color:var(--danger); }
.flag.tone-muted{ color:var(--muted); }
.ledger-table .note-cell{ max-width:180px; font-size:var(--fs-xs); color:var(--text-2); }
/* 探测进行中的整行压暗：让「正在跑」这件事在整屏上可见，
   否则几十行同时点亮时用户分不清哪些已经出结果。 */
.ledger-table tr.is-probing{ opacity:.5; }
.probe-bar{
  display:flex; align-items:center; gap:var(--sp-2);
  font-size:var(--fs-xs); color:var(--muted);
}
.progress.pulse > i{ animation:ledger-pulse 1.1s var(--ease) infinite; }
@keyframes ledger-pulse{ 0%{ opacity:.45; } 50%{ opacity:1; } 100%{ opacity:.45; } }
/* 编辑弹窗里的线路字段分组 */
.led-form-grid{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--sp-3); }
.led-form-grid .span-2{ grid-column:1 / -1; }
@media (max-width:640px){ .led-form-grid{ grid-template-columns:1fr; } }
.st-dot i{ width:8px; height:8px; border-radius:50%; background:var(--st-color); flex:0 0 8px; box-shadow:0 0 0 3px color-mix(in srgb,var(--st-color) 25%,transparent); }

