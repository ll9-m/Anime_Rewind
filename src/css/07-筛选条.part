/* ============================================================
   筛选条
   ============================================================ */
.filterbar{
  display:flex; flex-wrap:wrap; align-items:flex-end; gap:var(--sp-3);
  padding:var(--sp-3); margin-bottom:var(--sp-4);
  background:var(--panel); border:1px solid var(--border); border-radius:var(--r-lg);
}
.filterbar .field{ min-width:132px; }
.filterbar .field-wide{ min-width:200px; }
.filterbar .field label{ font-size:11px; }
.filterbar .btn{ min-height:36px; }
.filterbar-right{ margin-left:auto; display:flex; gap:var(--sp-2); align-items:center; }
.seg{ display:inline-flex; padding:2px; gap:2px; background:var(--panel-2); border:1px solid var(--border-2); border-radius:var(--r-md); }
.seg button{
  min-height:30px; padding:0 var(--sp-3); border:0; border-radius:var(--r-sm); cursor:pointer;
  background:transparent; color:var(--text-2); font-size:var(--fs-xs); display:inline-flex; align-items:center; gap:5px;
}
.seg button svg{ width:14px; height:14px; }
.seg button:hover{ color:var(--text); }
.seg button[aria-pressed="true"]{ background:var(--accent-soft); color:var(--text); box-shadow:inset 0 0 0 1px var(--accent); }

