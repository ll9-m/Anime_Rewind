/* DOM 微助手。注意 tools/scan-dead.js 的词边界正则对 $ 失效，
   别凭它删这两个 —— applyAppearance/设置页在用。 */
const $ = (sel, root) => (root || document).querySelector(sel);
const $$ = (sel, root) => Array.from((root || document).querySelectorAll(sel));
function esc(s){

  return String(s == null ? "" : s)
    .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function attr(s){ return esc(s); }
function uid(prefix){
  /* crypto.randomUUID 可用时优先用它（无碰撞）；旧引擎回落到时间戳+随机串。
     旧代码这行是半成品死代码：两分支都是 null，且 API 名拼错成 randomuuid。 */
  if(typeof crypto !== "undefined" && crypto.randomUUID) return (prefix||"id") + "_" + crypto.randomUUID();
  return (prefix||"id") + "_" + Date.now().toString(36) + Math.random().toString(36).slice(2,8);
}
function debounce(fn, ms){
  let t; return function(){ const args = arguments, self = this; clearTimeout(t); t = setTimeout(()=>fn.apply(self,args), ms); };
}
/* 中文输入法（IME）安全的 input 绑定。
   不加守卫的后果：拼音还没上屏时防抖回调就 rerender() 重建输入框，
   合成被顶掉，用户打一个词断一次（表现为「只剩拼音字母」）。
   规则：合成期间（compositionstart → compositionend）的 input 事件全部忽略，
   compositionend 时补触发一次 fn —— 拿到的一定是上屏后的完整文本。
   Chrome 的 compositionend 在最后一个 input 之后（靠这里补触发），
   Firefox/Safari 相反（fn 可能跑两次，调用处配 debounce 即可合并）。 */
function bindIMEInput(el, fn, opts){
  opts = opts || {};
  let composing = false;
  el.addEventListener("compositionstart", () => { composing = true; }, opts);
  el.addEventListener("compositionend", () => { composing = false; fn(); }, opts);
  el.addEventListener("input", () => { if(!composing) fn(); }, opts);
}
function clampNum(n, min, max){ n = Number(n); if(!isFinite(n)) n = min; return Math.min(max, Math.max(min, n)); }
function todayISO(){ const d = new Date(); return dateISO(d); }
function nowIso(){ return new Date().toISOString(); }
function dateISO(d){
  const p = n => String(n).padStart(2,"0");
  return d.getFullYear() + "-" + p(d.getMonth()+1) + "-" + p(d.getDate());
}
function parseDateOnly(s){
  if(!s) return null;
  const m = /^(\d{4})(?:-(\d{2}))?(?:-(\d{2}))?$/.exec(String(s).trim());
  if(!m) return null;
  return { year:+m[1], month:m[2]?+m[2]:null, day:m[3]?+m[3]:null };
}
function yearOf(s){ const p = parseDateOnly(s); return p ? p.year : null; }
function decadeOf(s){
  const y = yearOf(s); if(!y) return null;
  return Math.floor(y/10)*10 + "s";
}
function fmtNum(n){ return (Math.round(n*10)/10).toString(); }
function fmtInt(n){ return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g,","); }
function humanSize(bytes){
  if(bytes < 1024) return bytes + " B";
  if(bytes < 1024*1024) return (bytes/1024).toFixed(1) + " KB";
  return (bytes/1024/1024).toFixed(2) + " MB";
}
function reduceMotion(){
  return window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
}

/* 标题规范化（去空白、去书名号引号、英文小写、全角转半角；不做繁简转换） */
function normalize(s){
  let t = String(s == null ? "" : s);
  t = t.replace(/[\u3000\s]+/g, "");
  t = t.replace(/[《》「」『』〈〉“”‘’"'`‘’]/g, "");
  t = t.replace(/[\uFF01-\uFF5E]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));
  t = t.toLowerCase();
  return t;
}

