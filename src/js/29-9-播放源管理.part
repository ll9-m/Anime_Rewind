/* ============================================================
   16.9 播放源管理（台账页）
   ------------------------------------------------------------
   逐部管理线路解决不了三件事，这一页专门解决它们：
     ① 一眼看出哪些线路坏了（探测 + 人工标记失效）
     ② 批量处置（一次清掉全库标记失效的 / 重复的线路）
     ③ 补录与修改（不用回到某部作品的详情页里找输入框）
   ============================================================ */
const ledgerState = {
  q: "",
  /* 状态筛选。空串 = 全部；其余对应 sourceFlags 的语义 */
  filter: "",
  sort: "anime",
  picked: [],          /* 勾选的 "作品id|线路id" 复合键 */
  probing: false,
  progress: null       /* { done, total, label } */
};
const LEDGER_FILTERS = [
  { key:"",          name:"全部" },
  { key:"active",    name:"使用中" },
  { key:"dead",      name:"已失效" },
  { key:"unknown",   name:"未检测" },
  { key:"disabled",  name:"已停用" },
  { key:"no-source", name:"无播放源" }
];
const LEDGER_SORTS = [
  { key:"anime",  name:"按作品" },
  { key:"health", name:"按状态（问题优先）" },
  { key:"newest", name:"按添加时间" },
  { key:"host",   name:"按站点" }
];
/* 一行的复合键。source 为 null（待办行）时返回空串 ——
   空串永远不会出现在 ledgerState.picked 里，天然被排除在批量操作外。 */
function ledgerKey(row){
  if(!row || !row.source) return "";
  return row.anime.id + "|" + row.source.id;
}
/* 台账健康度排序键：问题越重越靠前。
   排序必须把「已失效」放最前 —— 用户打开这一页就是来处理问题的，
   把有问题的行排在最后一屏等于没做。 */
function ledgerHealthRank(row){
  const h = normalizeHealth(row.source.health);
  if(h.state === "dead") return 0;
  if(row.source.enabled === false) return 1;
  if(h.state === "blocked") return 2;
  if(h.state === "unknown") return 3;
  return 4;
}
function filterLedgerRows(rows){
  const q = normalize(ledgerState.q);
  let out = rows.filter(r => {
    if(ledgerState.filter === "no-source") return false;   /* 由下面的单独分支处理 */
    const flags = sourceFlags(r).map(f => f.id);
    if(ledgerState.filter && flags.indexOf(ledgerState.filter) < 0) return false;
    if(!q) return true;
    const a = r.anime;
    const hay = normalize([
      a.titleCn, a.titleOriginal, (a.aliases || []).join(" "),
      r.source.name, r.source.url, r.source.note, hostOf(r.source.url)
    ].join(" "));
    return hay.indexOf(q) >= 0;
  });
  /* 「无播放源」筛的是作品而不是线路，只能单独构造行 */
  if(ledgerState.filter === "no-source"){
    out = state.anime.filter(a => !(Array.isArray(a.sources) && a.sources.some(s => s && s.url)))
      .filter(a => !q || normalize([a.titleCn, a.titleOriginal].join(" ")).indexOf(q) >= 0)
      .map(a => ({ anime:a, source:null }));
  }
  const pick = ledgerState.sort;
  const byTitle = (a, b) =>
    String(a.anime.titleCn || a.anime.titleOriginal || "").localeCompare(
      String(b.anime.titleCn || b.anime.titleOriginal || ""), "zh");
  /* 三个按线路字段排的档位（状态/时间/站点）对 source 为 null 的行
     全部要退化成「按片名排」。这一层必须有兜底：
     「无播放源」那一档构出来的行 source 就是 null，
     而用户很可能正好在这一档切排序 —— 那一刻整页会崩成
     「页面渲染出错」，且只在特定操作顺序下复现。 */
  const hasSrc = list => list.filter(r => r.source);
  const onlyNull = list => list.filter(r => !r.source);
  const mergeSorted = (real, fake) => real.concat(fake.sort(byTitle));
  if(pick === "health"){
    const real = hasSrc(out).slice().sort((a, b) =>
      (ledgerHealthRank(a) - ledgerHealthRank(b)) || byTitle(a, b));
    out = mergeSorted(real, onlyNull(out));
  }else if(pick === "newest"){
    const real = hasSrc(out).slice().sort((a, b) =>
      String(b.source.savedAt || "").localeCompare(String(a.source.savedAt || "")) || byTitle(a, b));
    out = mergeSorted(real, onlyNull(out));
  }else if(pick === "host"){
    const real = hasSrc(out).slice().sort((a, b) =>
      hostOf(a.source.url).localeCompare(hostOf(b.source.url)) || byTitle(a, b));
    out = mergeSorted(real, onlyNull(out));
  }else{
    out = out.slice().sort(byTitle);
  }
  return out;
}
function pickedLedgerRows(all){
  const set = new Set(ledgerState.picked);
  return all.filter(r => r.source && set.has(ledgerKey(r)));
}
function ledgerStatHTML(rows){
  const st = sourceLedgerStats(rows);
  const cell = (n, label, tone) =>
    '<div class="ledger-stat' + (tone ? " tone-" + tone : "") + '"><b>' + n + "</b><span>" + label + "</span></div>";
  return '<div class="ledger-stats">' +
    cell(st.total, "线路总数", st.total ? "" : "") +
    cell(st.alive, "探测可达", st.alive ? "ok" : "") +
    cell(st.dead, "已标记失效", st.dead ? "err" : "") +
    cell(st.blocked, "访问不通", st.blocked ? "warn" : "") +
    cell(st.unknown, "未检测", "warn") +
    cell(st.disabled, "已停用", "") +
    cell(st.animeWithout, "作品尚无片源", st.animeWithout ? "warn" : "") +
    "</div>";
}
function ledgerRowHTML(row, picked){
  const a = row.anime, s = row.source;
  /* 无播放源的作品：这一行不是线路，是一条待办 */
  if(!s){
    return '<tr class="ledger-empty-row" data-anime="' + attr(a.id) + '">' +
      '<td class="col-check"></td>' +
      '<td class="col-src"><div class="truncate" style="max-width:280px">' +
        esc(a.titleCn || a.titleOriginal || "未命名") + "</div>" +
        '<span class="url-cell">尚未添加任何播放源</span></td>' +
      '<td colspan="5"><span class="hint">在放映厅打开这部作品即可添加线路</span></td>' +
      '<td class="nowrap"><button class="btn btn-sm" type="button" data-act="open-anime" data-id="' +
        attr(a.id) + '">去添加</button></td></tr>';
  }
  const flags = sourceFlags(row).map(f =>
    '<span class="flag tone-' + f.tone + '">' + esc(f.text) + "</span>").join("");
  const dead = normalizeHealth(s.health).state === "dead";
  const probing = ledgerState.probing && ledgerState.progress &&
    ledgerState.progress.keys && ledgerState.progress.keys.has(ledgerKey(row));
  const ep = s.ep == null ? "整季" : "第 " + s.ep + " 集";
  const meta = [s.resolution, ep].filter(Boolean).join(" · ");
  /* 「设为使用中」按钮：台账页不能只显示「哪条在用」而不给切换手段。
     用户在这里的意图是「整理」，顺手把默认线路换掉是自然动作 ——
     而原实现只在播放器的控制条里藏着选源入口，
     于是「管理」页能看不能改，想换默认线路必须先起播一次。 */
  const isActive = a.activeSourceId === s.id;
  /* 搜索型没有「设为使用中」：它播不了，设上去是假的使用中。
     换成「搜索」按钮 —— 带着这部作品的名字去站里搜，这才是它该干的事。 */
  const setBtn = sourceIsSearch(s)
    ? '<button class="btn btn-sm btn-icon" type="button" data-act="search" title="带片名去这个站搜索" aria-label="搜索">' +
      ic("search",14) + "</button>"
    : (isActive
      ? '<span class="flag tone-ok" title="当前默认线路">' + ic("target",12) + "使用中</span>"
      : '<button class="btn btn-sm btn-icon" type="button" data-act="use" title="设为使用中" aria-label="设为使用中">' +
        ic("target",14) + "</button>");
  /* checked 必须由数据回填，不能只靠 class。
     台账的每一次筛选/勾选/批量操作都会整表重渲，
     重渲出来的是全新 DOM —— 不写 checked 的话，
     「行高亮着但框里没勾」，用户看到的正是「勾不上 / 没箭头」。
     高亮（is-picked）与勾选（checked）必须同源，
     否则两者会各说各话。 */
  return '<tr class="' + (dead ? "is-dead " : "") + (picked ? "is-picked " : "") + (probing ? "is-probing" : "") +
      '" data-key="' + attr(ledgerKey(row)) + '" data-anime="' + attr(a.id) + '">' +
    '<td class="col-check"><input type="checkbox" data-act="pick" aria-label="选择 ' + attr(sourceDisplayName(s)) + '"' +
      (picked ? " checked" : "") + "></td>" +
    '<td class="col-src"><div class="truncate" style="max-width:260px">' +
      esc(a.titleCn || a.titleOriginal || "未命名") + "</div>" +
      '<span class="url-cell" title="' + attr(s.url) + '">' + esc(s.url) + "</span></td>" +
    "<td>" + esc(sourceDisplayName(s)) + (meta ? ' <span class="hint">' + esc(meta) + "</span>" : "") + "</td>" +
    '<td><div class="flag-row">' + flags + "</div></td>" +
    '<td class="note-cell">' + (s.note ? esc(s.note) : '<span class="hint">—</span>') + "</td>" +
    '<td class="nowrap small muted">' +
      "<div>" + (normalizeHealth(s.health).at ? esc(String(normalizeHealth(s.health).at).slice(0, 10)) : "—") + "</div>" +
      "<div>" + (s.lastUsedAt ? "用过 " + esc(String(s.lastUsedAt).slice(0, 10)) : "") + "</div></td>" +
    '<td class="nowrap">' +
      setBtn + " " +
      '<button class="btn btn-sm btn-icon" type="button" data-act="probe" title="探测这条线路" aria-label="探测">' + ic("refresh",14) + "</button> " +
      '<button class="btn btn-sm btn-icon" type="button" data-act="edit" title="编辑" aria-label="编辑">' + ic("edit",14) + "</button> " +
      '<button class="btn btn-sm btn-icon' + (s.enabled === false ? " is-on" : "") + '" type="button" data-act="toggle" title="停用/启用" aria-label="停用或启用">' + ic("eye",14) + "</button> " +
      '<button class="btn btn-sm btn-icon" type="button" data-act="dead" title="' + (dead ? "恢复" : "标记失效") + '" aria-label="标记失效或恢复">' + ic(dead ? "refresh" : "warning",14) + "</button> " +
      '<button class="btn btn-sm btn-icon" type="button" data-act="open" title="新标签打开" aria-label="新标签打开">' + ic("external",14) + "</button> " +
      '<button class="btn btn-sm btn-icon" type="button" data-act="del" title="删除线路" aria-label="删除线路">' + ic("trash",14) + "</button>" +
    "</td></tr>";
}
function renderLedger(root){
  const all = sourceLedger();
  const rows = filterLedgerRows(all);
  const stats = sourceLedgerStats(all);
  const dupes = ledgerDuplicates(all);
  const hasFilter = !!(ledgerState.q || ledgerState.filter || ledgerState.sort !== "anime" || ledgerState.picked.length);

  let html = '<div class="filterbar">' +
    '<div class="field field-wide ledger-q"><label for="led-q">搜索线路</label>' +
      '<div class="search-wrap">' + ic("search",16) +
      '<input class="input" id="led-q" type="search" placeholder="片名 / 线路名 / 网址 / 站点 / 备注" value="' + attr(ledgerState.q) + '"></div></div>' +
    '<div class="field"><label for="led-filter">状态</label><select class="select" id="led-filter">' +
      LEDGER_FILTERS.map(f => {
        /* 每个选项带上数量，用户不必先筛一遍才知道哪一类有问题 */
        const n = f.key === ""
          ? all.length + state.anime.filter(a => !(a.sources || []).some(s => s && s.url)).length
          : (f.key === "no-source"
              ? state.anime.filter(a => !(a.sources || []).some(s => s && s.url)).length
              : all.filter(r => sourceFlags(r).some(x => x.id === f.key)).length);
        return '<option value="' + attr(f.key) + '"' + (ledgerState.filter === f.key ? " selected" : "") + ">" +
          esc(f.name) + "（" + n + "）</option>";
      }).join("") +
    "</select></div>" +
    '<div class="field"><label for="led-sort">排序</label><select class="select" id="led-sort">' +
      LEDGER_SORTS.map(s => '<option value="' + attr(s.key) + '"' + (ledgerState.sort === s.key ? " selected" : "") + ">" +
        esc(s.name) + "</option>").join("") +
    "</select></div>" +
    '<div class="filterbar-right">' +
      (hasFilter ? '<button class="btn btn-sm" type="button" data-act="reset">' + ic("close",14) + "重置</button>" : "") +
      '<button class="btn btn-sm btn-primary" type="button" data-act="probe-all"' +
        (all.length ? "" : " disabled") + ">" + ic("refresh",14) + "批量探测</button>" +
    "</div></div>";

  html += ledgerStatHTML(all);

  /* 需要用户知道、但不该自动替他决定的事：重复线路不自动删，
     因为「同址不同集」可能是合法的两条。 */
  if(dupes.length){
    html += '<div class="note-box is-warn mb-3">' + ic("warning",16) +
      "<span>发现 " + dupes.length + " 条重复线路（同一部作品里网址与集数完全相同，" +
      '可能是反复添加留下的）。<button class="btn btn-sm" type="button" data-act="dedupe">去重</button>' +
      "</span></div>";
  }
  /* 全库失效时给出的是出路而不是结论 */
  if(stats.total && !stats.alive && !stats.unknown && !stats.blocked){
    html += '<div class="note-box is-err mb-3">' + ic("warning",16) +
      "<span>库中所有线路都已被标记失效，播放时会无源可用。" +
      '<button class="btn btn-sm" type="button" data-act="revive-all">全部恢复</button></span></div>';
  }
  if(ledgerState.probing && ledgerState.progress){
    const p = ledgerState.progress;
    const pct = p.total ? Math.round(p.done / p.total * 100) : 0;
    /* 三个 id 给 probeAll 的就地刷新用：批量探测期间不做整页重渲，
       只更新这几个节点 —— 全量重渲每 5 行一次，上千行时依然卡。 */
    html += '<div class="note-box mb-3"><div style="flex:1">' +
      '<div class="probe-bar"><span id="probe-bar-txt">' + esc(p.label) + " " + p.done + " / " + p.total + "</span>" +
      '<span id="probe-bar-pct" style="margin-left:auto">' + pct + "%</span></div>" +
      '<div class="progress pulse mt-2" style="height:6px"><i id="probe-bar-fill" style="width:' + pct + '%"></i></div>' +
      "</div></div>";
  }

  html += '<div class="row gap-2 mb-3" style="flex-wrap:wrap">' +
    '<button class="btn btn-sm" type="button" data-act="pick-all"' + (rows.length ? "" : " disabled") + ">" +
      ic("check",14) + "全选本页</button>" +
    '<button class="btn btn-sm" type="button" data-act="pick-none"' + (ledgerState.picked.length ? "" : " disabled") + ">" +
      ic("close",14) + "取消选择（" + ledgerState.picked.length + "）</button>" +
    '<button class="btn btn-sm" type="button" data-act="bulk-disable"' + (ledgerState.picked.length ? "" : " disabled") + ">" +
      ic("eye",14) + "停用所选</button>" +
    '<button class="btn btn-sm" type="button" data-act="bulk-use"' + (ledgerState.picked.length ? "" : " disabled") + ">" +
      ic("target",14) + "设为使用中</button>" +
    '<button class="btn btn-sm" type="button" data-act="bulk-enable"' + (ledgerState.picked.length ? "" : " disabled") + ">" +
      ic("check",14) + "启用所选</button>" +
    '<button class="btn btn-sm" type="button" data-act="bulk-dead"' + (ledgerState.picked.length ? "" : " disabled") + ">" +
      ic("warning",14) + "标记失效</button>" +
    '<button class="btn btn-danger btn-sm" type="button" data-act="bulk-del"' + (ledgerState.picked.length ? "" : " disabled") + ">" +
      ic("trash",14) + "删除所选</button>" +
    "</div>";

  html += rows.length
    ? '<div class="table-wrap scroll ledger-table"><table class="grid-table"><thead><tr>' +
        '<th class="col-check"></th><th class="col-src">作品 / 网址</th><th>线路</th><th>状态</th>' +
        "<th>备注</th><th>检测 / 使用</th><th>操作</th>" +
      "</tr></thead><tbody>" + rows.map(r =>
        /* ledgerKey 要读 row.source.id，而「无播放源」档位的行 source 是 null。
           选中态判定必须放在渲染函数内部去问「这行有没有线路」，
           不能在 map 里无脑调 ledgerKey —— 那样整页会崩成
           「页面渲染出错」，而且只在切到那一档时复现。 */
        ledgerRowHTML(r, r.source && ledgerState.picked.indexOf(ledgerKey(r)) >= 0)).join("") +
      "</tbody></table></div>"
    : '<div class="state-box">' + ic(all.length ? "search" : "link", 40) +
      (all.length
        ? "<h2>没有符合条件的线路</h2><p>换个状态或清空搜索词。</p>" +
          '<div class="row"><button class="btn" type="button" data-act="reset">重置筛选</button></div>'
        : "<h2>还没有任何播放源</h2><p>到放映厅打开一部作品，在「播放源」里粘一个网址即可。</p>" +
          '<div class="row"><button class="btn btn-primary" type="button" data-act="goto-theater">去放映厅</button></div>') +
      "</div>";

  root.innerHTML = html;
  bindLedger(root, all, rows);
}
function rerenderLedger(){ rerender(); }

/* ---- 事件绑定 ----
   用事件委托：台账的按钮全是渲染时批量生成的，
   逐个 addEventListener 在 200 行表格里既慢又容易漏。 */
function bindLedger(root, all, rows){
  const q = root.querySelector("#led-q");
  if(q) bindIMEInput(q, debounce(() => {
    ledgerState.q = q.value;
    rerenderLedger();
    const n = root.querySelector("#led-q");
    if(n){ n.focus(); n.setSelectionRange(n.value.length, n.value.length); }
  }, 280));
  const f = root.querySelector("#led-filter");
  if(f) f.addEventListener("change", () => { ledgerState.filter = f.value; rerenderLedger(); });
  const s = root.querySelector("#led-sort");
  if(s) s.addEventListener("change", () => { ledgerState.sort = s.value; rerenderLedger(); });

  /* 委托监听必须**只挂一次**。
     rerenderLedger 走的是 rerender → renderRoute → page.render(view)，
     而 #view 这个节点本身从不替换、只换 innerHTML，
     所以每次重渲染都往同一个 root 上再挂一遍监听器：
     第三次点按钮就会触发三次，一次操作弹出三个吐司，
     批量操作更会连着写三次库。症状是「吐司刷屏」，
     看起来像渲染有问题，实际是监听器叠了 N 层。
     用 dataset 打标记做幂等 —— 比 abortController 简单，
     且不影响同一页面上其它委托绑定。 */
  if(root.dataset.ledgerBound) return;
  root.dataset.ledgerBound = "1";

  /* 只挂一次委托之后，闭包里的 all/rows/dupes 就成了**首次渲染的快照**，
     增删改之后全是旧的。所以这三样一律现取，绝不缓存到闭包里。 */
  const rowByKey = (key) => sourceLedger().find(r => r.source && ledgerKey(r) === key) || null;

  root.addEventListener("change", (e) => {
    const box = e.target.closest('[data-act="pick"]');
    if(!box) return;
    const key = box.closest("tr").dataset.key;
    const i = ledgerState.picked.indexOf(key);
    if(box.checked && i < 0) ledgerState.picked.push(key);
    else if(!box.checked && i >= 0) ledgerState.picked.splice(i, 1);
    rerenderLedger();
  });

  root.addEventListener("click", async (e) => {
    const btn = e.target.closest("[data-act]");
    if(!btn || !root.contains(btn)) return;
    const act = btn.dataset.act;
    const tr = btn.closest("tr");
    const row = tr && tr.dataset.key ? rowByKey(tr.dataset.key) : null;

    if(act === "reset"){
      ledgerState.q = ""; ledgerState.filter = ""; ledgerState.sort = "anime"; ledgerState.picked = [];
      rerenderLedger(); return;
    }
    if(act === "goto-theater"){ go("theater"); return; }
    if(act === "open-anime"){ go("theater", btn.dataset.id); return; }
    if(act === "pick-all"){
      filterLedgerRows(sourceLedger()).forEach(r => {
        if(!r.source) return;
        const k = ledgerKey(r);
        if(ledgerState.picked.indexOf(k) < 0) ledgerState.picked.push(k);
      });
      rerenderLedger(); return;
    }
    if(act === "pick-none"){ ledgerState.picked = []; rerenderLedger(); return; }
    if(act === "probe-all"){ await probeAll(); return; }
    if(act === "probe"){ if(row) await probeOne(row); return; }
    if(act === "edit"){ if(row) openSourceEditor(row); return; }
    if(act === "use"){
      if(!row) return;
      const res = await setActiveSource(row);
      if(!res.ok){
        toast(res.reason === "search_only"
          ? "这条是搜索型片源，不能设为播放线路；点「搜索」直接带着片名去站里搜"
          : "保存失败，线路没换成", "warn");
        return;
      }
      const name = sourceDisplayName(row.source);
      toast(res.usable
        ? "已把「" + name + "」设为使用中"
        : "已把「" + name + "」设为使用中，但这条已被停用或标记失效，播放时会被跳过",
        res.usable ? "ok" : "warn");
      rerenderLedger(); return;
    }
    if(act === "open"){
      if(row) window.open(normalizeStreamURL(row.source.url), "_blank", "noopener,noreferrer");
      return;
    }
    /* 搜索型在台账里的主操作：带着这部作品的名字去站里搜。 */
    if(act === "search"){
      if(row) await openSiteSearch(row.anime, row.source);
      return;
    }
    if(act === "toggle"){
      if(!row) return;
      const off = row.source.enabled === false;
      await updateSource(row, { enabled:off });
      toast(off ? "已启用「" + sourceDisplayName(row.source) + "」" : "已停用「" + sourceDisplayName(row.source) + "」", "ok");
      rerenderLedger(); return;
    }
    if(act === "dead"){
      if(!row) return;
      const dead = normalizeHealth(row.source.health).state === "dead";
      await markSourceDead(row, !dead);
      toast(dead ? "已恢复为可用" : "已标记失效：选源时会跳过它", "ok");
      rerenderLedger(); return;
    }
    if(act === "del"){
      if(!row) return;
      const name = sourceDisplayName(row.source);
      const ok = await confirmDialog({
        title:"删除线路", danger:true, okText:"删除",
        html:"确定删除《" + esc(row.anime.titleCn || row.anime.titleOriginal || "未命名") + "》的线路「" + esc(name) + "」吗？<br>" +
          "<span class=\"hint\">只删这一条线路，不影响作品本身。此操作无法撤销。</span>"
      });
      if(!ok) return;
      const res = await deleteSource(row);
      ledgerState.picked = ledgerState.picked.filter(k => k !== ledgerKey(row));
      toast(res ? ("已删除，还剩 " + res.left + " 条线路") : "删除失败", res ? "ok" : "err");
      rerenderLedger(); return;
    }
    if(act === "bulk-disable" || act === "bulk-enable"){
      const list = pickedLedgerRows(sourceLedger());
      if(!list.length) return;
      const on = act === "bulk-enable";
      for(const r of list) await updateSource(r, { enabled:on });
      toast((on ? "已启用 " : "已停用 ") + list.length + " 条线路", "ok");
      rerenderLedger(); return;
    }
    if(act === "bulk-use"){
      const list = pickedLedgerRows(sourceLedger());
      if(!list.length) return;
      const ok = await confirmDialog({
        title:"批量设为使用中", okText:"设好",
        html:"将把选中的 <b>" + list.length + "</b> 条线路里每部作品的<b>第一条</b>" +
          "设为该作品的默认线路。<br>" +
          '<span class="hint">同一部作品勾了多条时只取第一条。设为使用中的线路，下次打开该作品会优先起播它。</span>'
      });
      if(!ok) return;
      const done = await setActiveSources(list);
      const animes = new Set(done.map(r => r.anime.id)).size;
      toast("已把 " + animes + " 部作品的默认线路改掉", "ok");
      rerenderLedger(); return;
    }
    if(act === "bulk-dead"){
      const list = pickedLedgerRows(sourceLedger());
      if(!list.length) return;
      for(const r of list) await markSourceDead(r, true);
      toast("已把 " + list.length + " 条线路标记为失效", "ok");
      rerenderLedger(); return;
    }
    if(act === "bulk-del"){
      const list = pickedLedgerRows(sourceLedger());
      if(!list.length) return;
      const ok = await confirmDialog({
        title:"批量删除线路", danger:true, okText:"删除 " + list.length + " 条",
        html:"确定删除选中的 <b>" + list.length + "</b> 条线路吗？<br>" +
          "<span class=\"hint\">涉及 " + new Set(list.map(r => r.anime.id)).size +
          " 部作品，只删线路不删作品。删除后无法撤销，建议先导出备份。</span>"
      });
      if(!ok) return;
      const res = await deleteSources(list);
      ledgerState.picked = [];
      toast(res.failed.length
        ? ("已删除 " + res.removed.length + " 条，" + res.failed.length + " 条失败：" + res.failed.join("、"))
        : ("已删除 " + res.removed.length + " 条线路"), res.failed.length ? "warn" : "ok");
      rerenderLedger(); return;
    }
    if(act === "dedupe"){
      /* 现取：上一轮去重已经改过库里数据，闭包里的旧 dupes 会二次删除 */
      const dupes = ledgerDuplicates(sourceLedger());
      if(!dupes.length){ toast("当前没有重复线路", "info"); return; }
      const ok = await confirmDialog({
        title:"清理重复线路", danger:true, okText:"清理",
        html:"将删除 <b>" + dupes.length + "</b> 条重复线路（同一部作品里网址与集数完全相同的多余项），<br>" +
          "每组重复保留最早添加的那一条。<span class=\"hint\">此操作无法撤销。</span>"
      });
      if(!ok) return;
      let n = 0;
      for(const d of dupes){ if(await deleteSource(d)) n++; }
      toast(n ? ("已清理 " + n + " 条重复线路") : "没有可清理的重复项", n ? "ok" : "warn");
      rerenderLedger(); return;
    }
    if(act === "revive-all"){
      const dead = sourceLedger().filter(r => normalizeHealth(r.source.health).state === "dead");
      for(const r of dead) await markSourceDead(r, false);
      toast("已恢复 " + dead.length + " 条线路", "ok");
      rerenderLedger(); return;
    }
  });
}
/* 逐条探测。整表重渲会打断用户正在点的按钮，
   所以探测期间就地更新状态文本，只有开始/结束才重绘整页。 */
async function probeOne(row){
  const res = await probeSource(row);
  /* 与 probeAll 同一原则：手动失效是判断不是观测，探测不能抹掉它。
     旧实现单条探测会直接覆盖 —— 用户标了失效的广告站，手滑点一下探测就「复活」了。 */
  const cur = normalizeHealth(row.source.health);
  if(cur.state === "dead"){
    toast("探测结果：" + HEALTH_TEXT[res.state] + "（已保留手动失效标记；要恢复请用「恢复」）", "warn", 5000);
  }else{
    await updateSource(row, { health:res });
    toast(sourceDisplayName(row.source) + "：" + HEALTH_TEXT[res.state] + " · " + res.detail,
      res.state === "alive" ? "ok" : "warn", 4200);
  }
  rerenderLedger();
}
/* 批量探测：串行 + 每条之间让出主线程。
   并发 5 条以上会让所有请求同时超时（对方站点排队把我们当攻击），
   那种情况下拿回一堆「不通」，比不探测更糟。 */
async function probeAll(){
  const all = sourceLedger();
  if(!all.length) return;
  ledgerState.probing = true;
  ledgerState.progress = { done:0, total:all.length, label:"正在探测", keys:new Set() };
  rerenderLedger();
  /* 就地更新进度条。批量探测几百条时每条最多等 9 秒超时，
     整个循环可能持续几十分钟 —— 不刷新的话进度条全程冻结在 0%，
     用户无从判断是卡死还是在跑。 */
  const paintProgress = () => {
    const p = ledgerState.progress;
    if(!p) return;
    const pct = p.total ? Math.round(p.done / p.total * 100) : 0;
    const txt = document.getElementById("probe-bar-txt");
    const pctEl = document.getElementById("probe-bar-pct");
    const fillEl = document.getElementById("probe-bar-fill");
    if(txt) txt.textContent = p.label + " " + p.done + " / " + p.total;
    if(pctEl) pctEl.textContent = pct + "%";
    if(fillEl) fillEl.style.width = pct + "%";
  };
  let ok = 0, blocked = 0, dead = 0;
  for(const row of all){
    ledgerState.progress.keys.add(ledgerKey(row));
    const res = await probeSource(row);
    /* 探测结果只覆盖「未检测/被拒」两类：
       用户手动标的失效是判断，不是观测，不能被一次网络波动抹掉。 */
    const cur = normalizeHealth(row.source.health);
    if(cur.state !== "dead") await updateSource(row, { health:res });
    else dead++;   /* 手动失效被保护跳过，计入汇报 */
    if(res.state === "alive") ok++; else blocked++;
    ledgerState.progress.done++;
    paintProgress();
    /* 每条之间让出主线程，进度条与页面保持可响应 */
    if(ledgerState.progress.done % 5 === 0) await new Promise(r => setTimeout(r, 0));
  }
  ledgerState.probing = false;
  ledgerState.progress = null;
  toast("探测完成：" + ok + " 条可达，" + blocked + " 条不通" + (dead ? "，" + dead + " 条保持手动失效" : ""), ok ? "ok" : "warn", 5000);
  rerenderLedger();
}
/* 线路编辑弹窗。字段比详情页多（备注、状态、优先级），
   因为这里的用户意图是「整理」，不是「随手记一条」。 */
function openSourceEditor(row){
  const a = row.anime, s = row.source;
  const dead = normalizeHealth(s.health).state === "dead";
  const root = openModal({
    title:"编辑线路",
    body:
      '<p class="small muted mb-3">《' + esc(a.titleCn || a.titleOriginal || "未命名") + "》 · " +
      '<span class="url-cell">' + esc(s.url) + "</span></p>" +
      '<div class="led-form-grid">' +
        '<div class="field span-2"><label for="ls-url">播放网址</label>' +
          '<input class="input" id="ls-url" type="url" inputmode="url" spellcheck="false" value="' + attr(s.url) + '"></div>' +
        '<div class="field"><label for="ls-name">线路名称</label>' +
          '<input class="input" id="ls-name" type="text" maxlength="40" value="' + attr(s.name || "") + '"></div>' +
        '<div class="field"><label for="ls-ep">对应集数</label>' +
          '<input class="input" id="ls-ep" type="number" min="1" step="1" placeholder="留空 = 整季通用" value="' +
            (s.ep == null ? "" : s.ep) + '"></div>' +
        '<div class="field"><label for="ls-res">分辨率</label><select class="select" id="ls-res">' +
          '<option value="">未标注</option>' +
          RESOLUTION_ORDER.map(r => '<option value="' + r + '"' + (s.resolution === r ? " selected" : "") + ">" + r + "</option>").join("") +
          "</select></div>" +
        '<div class="field"><label for="ls-tier">线路优先级</label>' +
          '<select class="select" id="ls-tier">' +
          [0,1,2,3,4,5].map(t => '<option value="' + t + '"' + (Number(s.tier) === t ? " selected" : "") +
            ">" + t + " · " + ["最快","较快","普通","较慢","最慢","备用"][t] + "</option>").join("") +
          "</select></div>" +
        '<div class="field"><label for="ls-kind">字幕形态</label><select class="select" id="ls-kind">' +
          SUBTITLE_KINDS.map(k => '<option value="' + k + '"' + (s.subtitleKind === k ? " selected" : "") + ">" +
            ({ EXTERNAL:"外挂字幕（可关闭）", CLOSED:"内封字幕轨", EMBEDDED:"硬字幕（不可关闭）" })[k] + "</option>").join("") +
          "</select></div>" +
        '<div class="field"><label for="ls-subs">字幕语言（可多选）</label>' +
          '<div class="row gap-2" id="ls-subs" style="flex-wrap:wrap">' +
          SUBTITLE_ORDER.map(l => '<label class="checkline small"><input type="checkbox" value="' + l + '"' +
            ((s.subtitles || []).indexOf(l) >= 0 ? " checked" : "") + "><span>" + l + "</span></label>").join("") +
          "</div></div>" +
        '<div class="field span-2"><label for="ls-note">备注（只给自己看）</label>' +
          '<input class="input" id="ls-note" type="text" maxlength="200" placeholder="例如：需要登录 / 1080P 有慢放 / 备用线路" value="' +
          attr(s.note || "") + '"></div>' +
        '<div class="field"><label>启用状态</label>' +
          '<label class="checkline"><input type="checkbox" id="ls-enabled"' + (s.enabled !== false ? " checked" : "") +
          "><span>参与选源</span></label></div>" +
        '<div class="field"><label>失效标记</label>' +
          '<label class="checkline"><input type="checkbox" id="ls-dead"' + (dead ? " checked" : "") +
          "><span>已失效（选源时跳过）</span></label></div>" +
        /* 搜索型必须能改模板：模板猜错了要能救回来，
           否则用户只能删掉重加，还得再猜一次。 */
        (sourceIsSearch(s)
          ? '<div class="field span-2"><label for="ls-search">搜索网址模板（<code>{kw}</code> 会被替换成片名）</label>' +
            '<input class="input" id="ls-search" type="text" spellcheck="false" value="' + attr(s.searchUrl || "") + '"></div>'
          : "") +
      "</div>" +
      '<div class="note-box mt-3">' + ic("info",16) +
        "<span>当前状态：" + esc(HEALTH_TEXT[normalizeHealth(s.health).state]) +
        (normalizeHealth(s.health).at ? "（" + esc(String(normalizeHealth(s.health).at).slice(0, 16)) + "）" : "") +
        (normalizeHealth(s.health).detail ? " · " + esc(normalizeHealth(s.health).detail) : "") + "</span></div>",
    footer:(f) => {
      f.innerHTML = '<span class="hint">「参与选源」与「已失效」互斥：失效线路不会再被自动选中</span><div class="grow"></div>' +
        '<button class="btn" type="button" data-close="1">取消</button>' +
        '<button class="btn btn-primary" type="button" id="ls-save">保存</button>';
      f.querySelector("#ls-save").addEventListener("click", onSave);
    }
  });
  async function onSave(){
    const urlRaw = root.querySelector("#ls-url").value.trim();
    const norm = normalizeStreamURL(urlRaw);
    const msg = root.querySelector("#ls-msg") || (() => {
      const d = document.createElement("div");
      d.className = "err-text mt-2";
      root.querySelector(".modal-body").appendChild(d);
      return d;
    })();
    msg.textContent = "";
    if(!norm){ msg.textContent = "网址无效：只接受 http / https 开头的地址"; return; }
    const epRaw = root.querySelector("#ls-ep").value.trim();
    let ep = null;
    if(epRaw !== ""){
      ep = Number(epRaw);
      if(!Number.isInteger(ep) || ep < 1){ msg.textContent = "集数必须是大于 0 的整数"; return; }
    }
    /* 改成另一条已存在的线路会让台账出现重复项。
       这里只提示不阻止：用户可能就是要指向同一条（比如改名后重排）。 */
    const dup = findDuplicateIn(a, norm, ep);
    if(dup && dup.id !== s.id && !msg.textContent){
      msg.textContent = "提示：这部作品里已经有一条相同网址与集数的线路（「" +
        sourceDisplayName(dup) + "」），保存后会形成重复项。";
    }
    const subs = Array.from(root.querySelectorAll('#ls-subs input:checked')).map(i => i.value);
    const isDead = root.querySelector("#ls-dead").checked;
    const enabled = root.querySelector("#ls-enabled").checked;
    /* 失效标记两个方向都必须生效：勾上 → dead；
       取消 → 从 dead 回到 unknown（旧实现原样保留 dead，取消是静默空操作）；
       手动改动网址后旧的探测结论立刻作废：
       拿「上一个地址的可达性」去描述新地址是在骗用户。 */
    let health;
    if(norm !== s.url) health = { state:"unknown", at:"", detail:"" };
    else if(isDead) health = { state:"dead", at:nowIso(), detail:"用户手动标记失效" };
    else{
      const h = normalizeHealth(s.health);
      health = h.state === "dead" ? { state:"unknown", at:"", detail:"" } : h;
    }
    const ok = await updateSource(row, {
      url: norm,
      name: root.querySelector("#ls-name").value.trim(),
      ep: ep,
      resolution: root.querySelector("#ls-res").value || null,
      tier: Number(root.querySelector("#ls-tier").value),
      subtitleKind: root.querySelector("#ls-kind").value,
      subtitles: subs,
      note: root.querySelector("#ls-note").value.trim(),
      enabled: enabled,
      searchUrl: (root.querySelector("#ls-search") ? root.querySelector("#ls-search").value.trim() : s.searchUrl),
      health: health
    });
    if(!ok){ msg.textContent = "保存失败，请重试"; return; }
    syncLegacyStreamFields(a);
    await persistAnimeQuiet(a);
    closeModal();
    toast("线路已更新", "ok");
    rerenderLedger();
  }
}

registerPage({
  id:"sources", name:"播放源", icon:"link", title:"播放源管理",
  sub:"全库线路台账：探测失效、批量清理、按站点整理",
  settingKey:"module_sources",
  actions(box){
    const all = sourceLedger();
    const st = sourceLedgerStats(all);
    box.innerHTML = '<span class="hint">' +
      (all.length
        ? "共 " + all.length + " 条线路 · " + st.dead + " 条已失效"
        : "还没有线路") + "</span>";
    const b = box.querySelector("[data-act=add-anime]");
    if(b) b.addEventListener("click", () => go("library"));
  },
  render: renderLedger
});

