/* ============================================================
   浏览器表面
   这些控件不由我绘制，却必须携带设计语言：选区、焦点环、滚动条、
   文本插入符、链接下划线偏移、数字对齐。未处理的浏览器表面是
   「拼装」与「建造」最直接的分界。
   ============================================================ */
::selection{ background:var(--accent); color:var(--accent-ink); }
:focus{ outline:none; }
:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; border-radius:var(--r-sm); }

/* 文本插入符跟随强调色 */
input,textarea{ caret-color:var(--accent); }
input::placeholder,textarea::placeholder{ color:var(--muted); opacity:.72; }

/* 数字一律等宽对齐 —— 数据密集界面的基本素养 */
.num,.stat-value,.kbd,.mono{ font-family:var(--font-mono); font-variant-numeric:tabular-nums; font-feature-settings:"tnum" 1,"zero" 1; }

/* 滚动条：细、低对比、hover 才显形，不抢内容注意力 */
*::-webkit-scrollbar{ width:10px; height:10px; }
*::-webkit-scrollbar-track{ background:transparent; }
*::-webkit-scrollbar-thumb{ background:var(--border-2); border-radius:var(--r-pill); border:3px solid transparent; background-clip:content-box; }
*::-webkit-scrollbar-thumb:hover{ background:var(--muted); background-clip:content-box; }
*::-webkit-scrollbar-corner{ background:transparent; }
.scroll{ scrollbar-width:thin; scrollbar-color:var(--border-2) transparent; }
.scroll::-webkit-scrollbar-thumb{ border-width:2px; }

/* 链接下划线从基线偏移，悬停时加深 */
a{ text-underline-offset:.22em; text-decoration-thickness:1px; }
a:hover{ text-decoration-thickness:2px; }
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; }
}

/* 旧滚动条规则已上移至「浏览器表面」统一处理 */

