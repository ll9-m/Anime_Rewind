/* UI 套系：与配色主题正交的形态层。
   archive = 现有的档案馆风格（默认）；pixel = 像素风；holo = 科技感；
   tv = 参考 Izuko_TV 的电视端布局（大图横滑卡行 + 可折叠侧栏 + 深灰底）。
   新增套系只需加一段 [data-skin="..."] 覆盖，不需动任何布局代码。 */
const UI_SKINS = ["archive", "pixel", "holo", "tv"];
/* TV 套系的几何常量。来源是 Izuko_TV 的 TvPosterWall.kt，
   不是自己拟的数值 —— 那些数字是照Apple TV 一屏 6 张反推出来的，
   改成别的会连带破坏「一屏 6 张」的观感。 */
/* 几何常量。CSS 侧统一用 var(--tv-*) 取值，本对象是唯一的数值来源 ——
   原来 CSS 里另写了一份 --rail-w/--tv-bleed，与这里的数字各活各的，
   改一处忘另一处就会出「CSS 说 48px、列数公式按 236 算」这类错位。
   同一段脚本里把这些值写进 CSS 变量（见 applyTvTokens）。 */
const TV_LAYOUT = {
  railCollapsed: 48,      /* 收起态占位宽，让内容左缘与详情页对齐 */
  railOpen: 216,          /* 展开态宽：48 收起 + 168 文字，放得下最长系列名 */
  cardMinWidth: 118,      /* 不是 124：留余量防边界抖动掉到 5 列 */
  columnSpacing: 20,
  bottomBleed: 64,        /* 下出血：焦点走过去时按位置跑动画，不闪现 */
  bgTone: "#2C2C2E"       /* 深灰而非纯黑 —— 纯黑在屏幕上与深灰分不出来 */
};
/* 把 JS 侧的几何写进 CSS 变量。切套系时由 applyAppearance 调用 ——
   不这样做的话 CSS 里的字面值与这里就成了两个独立真相。 */
function applyTvTokens(){
  const s = document.documentElement.style;
  s.setProperty("--rail-w", TV_LAYOUT.railCollapsed + "px");
  s.setProperty("--rail-w-open", TV_LAYOUT.railOpen + "px");
  s.setProperty("--tv-bleed", TV_LAYOUT.bottomBleed + "px");
  s.setProperty("--tv-gap", TV_LAYOUT.columnSpacing + "px");
  s.setProperty("--card-min", TV_LAYOUT.cardMinWidth + "px");
}

/* 横滑卡行与剧集卡的额度，数值全部来自 Izuko_TV，不是自拟：
     watchNextLimit  ← TvHomeChannels.WATCH_NEXT_LIMIT
     seriesRowLimit  ← 主屏频道一屏放不下的行数，超出的走「更多」卡
     epCardWidth     ← FocusEpisodesSection 的 cellWidth（dp）
     epCardHeight    ← 同文件 cellHeight，恰好 16:9
     epDimAlpha      ← EPISODE_PAST_CARD_DIM_ALPHA（已看卡整体压暗到 .45）
     epProgressH     ← EPISODE_PROGRESS_BAR_HEIGHT
   epRowLimit 不是抄来的：抓取侧只存作品级封面与总集数，
   一部 1000 集的长番按集号铺开能把页面卡死，所以自己封了顶。 */
const TV_ROW = {
  watchNextLimit: 10,
  seriesRowLimit: 12,
  epCardWidth: 256,
  epCardHeight: 144,
  epDimAlpha: 0.45,
  epProgressH: 3,
  epRowLimit: 60,
  moreThreshold: 8      /* 行内卡片少于这个数就不挂「更多」卡，空行尾反而是噪音 */
};
