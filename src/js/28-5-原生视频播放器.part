/* ============================================================
   17.5 原生视频播放器
   ------------------------------------------------------------
   双轨设计：
     直链（mp4 / webm / m4v 等浏览器能自己解的）→ <video>，
     需要联网换算或站点只允许嵌入 → 沿用 iframe。
   不用「一律 iframe」的原因：iframe 里读不到 currentTime，
   续播与片尾自动下一集都无从谈起 —— 这两件事都要时间轴。

   键盘语义照 Izuko_TV 的 TvEpisodeScreen：
     ← →        快退 / 快进 5 秒（不唤出控制层）
     ↑ ↓        显示控制层
     空格/回车  播放暂停
     长按空格   临时倍速（松开恢复），默认 2.5×
     F          全屏
   长按加速的斜坡与短片保护也照搬 scrubStepMillis：
     按住越久走得越快（8 发加一档，12× 到顶），
     但用 总时长/60 压一道上限 —— 12 倍对两小时电影合适，
     对 3 分钟 PV 却是一发就冲到头。 */
const VP = {
  seekStepMs: 5000,
  holdSpeed: 2.5,
  maxRampSpeed: 12,
  rampRepeats: 8,
  minRepeatsAcross: 60,
  autoHideMs: 5000,
  finishThresholdMs: 5000
};
/* 斜坡步长：直译 scrubStepMillis。 */
function scrubStepMillis(totalMs, repeats){
  if(!Number.isFinite(totalMs) || totalMs <= 0) return VP.seekStepMs;
  const speedup = Math.min(1 + Math.max(0, repeats - 1) / VP.rampRepeats, VP.maxRampSpeed);
  const ramped = VP.seekStepMs * speedup;
  const cap = Math.max(totalMs / VP.minRepeatsAcross, VP.seekStepMs);
  return Math.min(ramped, cap);
}
function fmtClock(sec){
  if(!Number.isFinite(sec) || sec < 0) sec = 0;
  const s = Math.floor(sec % 60), m = Math.floor(sec / 60) % 60, h = Math.floor(sec / 3600);
  const two = n => String(n).padStart(2, "0");
  return h > 0 ? (h + ":" + two(m) + ":" + two(s)) : (m + ":" + two(s));
}
/* 浏览器能否自己播这个地址。
   mp4/webm/m4v/ogg 是确定能解的；m3u8 原生 Safari 能解、其他浏览器不能。
   不做嗅探式尝试 —— 判断错一次的代价是黑屏加一段无意义的等待。 */
function isDirectPlayable(url){
  const u = String(url || "").toLowerCase();
  if(!u) return false;
  if(/\.(mp4|webm|m4v|mov|ogv|ogg|mp3|m4a|aac|flac)(\?|#|$)/.test(u)) return true;
  return false;
}

/* 挂载原生播放器。返回清理函数。
   a 可以为 null（未选作品的临时片源），此时不落盘进度。 */
function mountVideoPlayer(mountEl, srcObj, a, onLineChange){
  const video = document.createElement("video");
  video.className = "vplayer";
  video.setAttribute("playsinline", "");
  video.setAttribute("preload", "metadata");
  video.setAttribute("crossorigin", "anonymous");
  video.src = srcObj.url;
  video.volume = 0.85;

  const scrimTop = document.createElement("div");
  scrimTop.className = "vplayer-scrim vplayer-scrim-top";
  const title = document.createElement("div");
  title.className = "vplayer-title";
  title.innerHTML = "<b>" + esc(srcObj.name || "播放") + "</b>" +
    (srcObj.resolution ? "<span>" + esc(srcObj.resolution) + "</span>" : "");
  const scrimBot = document.createElement("div");
  scrimBot.className = "vplayer-scrim vplayer-scrim-bot";

  /* 进度条 */
  const bar = document.createElement("div");
  bar.className = "vplayer-bar";
  const btnPlay = document.createElement("button");
  btnPlay.className = "vplayer-btn"; btnPlay.type = "button";
  btnPlay.title = "播放 / 暂停"; btnPlay.setAttribute("aria-label", "播放或暂停");
  const track = document.createElement("div");
  track.className = "vplayer-track"; track.setAttribute("role", "slider");
  track.setAttribute("aria-label", "播放进度");
  const rail = document.createElement("div"); rail.className = "vplayer-track-rail";
  const buf = document.createElement("div"); buf.className = "vplayer-track-buf";
  const fill = document.createElement("div"); fill.className = "vplayer-track-fill";
  const knob = document.createElement("div"); knob.className = "vplayer-knob";
  track.append(rail, buf, fill, knob);
  const time = document.createElement("div");
  time.className = "vplayer-time"; time.textContent = "0:00 / 0:00";
  const btnMute = document.createElement("button");
  btnMute.className = "vplayer-btn"; btnMute.type = "button";
  btnMute.title = "静音"; btnMute.setAttribute("aria-label", "静音开关");
  bar.append(btnPlay, track, time, btnMute);

  /* 图标行 */
  const btns = document.createElement("div");
  btns.className = "vplayer-btns";
  const mk = (label, title2, cls) => {
    const b = document.createElement("button");
    b.className = "vplayer-btn " + (cls || ""); b.type = "button";
    b.title = title2; b.setAttribute("aria-label", title2); b.dataset.vp = label;
    return b;
  };
  const bBack = mk("back", "后退 5 秒");
  const bFwd = mk("fwd", "前进 5 秒");
  const bRate = mk("rate", "倍速", "vplayer-btn-text");
  bRate.textContent = "1.0×";
  const bFull = mk("full", "全屏");
  const bSrc = mk("source", "选源", "vplayer-btn-text");
  bSrc.textContent = "选源";
  const grow = document.createElement("div"); grow.className = "grow";
  const bOpen = mk("open", "新标签打开");
  btns.append(bBack, bFwd, bRate, grow, bSrc, bOpen, bFull);
  scrimBot.append(bar, btns);

  const center = document.createElement("button");
  center.className = "vplayer-center"; center.type = "button";
  center.setAttribute("aria-label", "播放");
  const badge = document.createElement("div"); badge.className = "vplayer-badge";
  const rateHint = document.createElement("div"); rateHint.className = "vplayer-rate";

  /* 选源面板 */
  const panel = document.createElement("div");
  panel.className = "vplayer-panel";
  panel.innerHTML = '<div class="vplayer-panel-head">' + ic("film", 16) +
    "<h4>播放源</h4><span class=\"hint\" id=\"vp-src-hint\"></span>" +
    '<div class="grow"></div>' +
    '<button class="btn btn-sm" type="button" data-vp="panel-close">收起</button></div>' +
    '<div class="vplayer-panel-body" id="vp-src-body"></div>';

  mountEl.innerHTML = "";
  mountEl.append(video, scrimTop, title, scrimBot, center, badge, rateHint, panel);

  /* ---- 状态 ---- */
  let idleTimer = null, badgeTimer = null, rateTimer = null;
  let rateBack = null;          /* 长按加速前的倍速，松开要还回去 */
  let dragging = false;
  let interacted = false;       /* 是否已经发生过真实播放，用于 ended 守卫 */
  /* ---- 续播进度 ----
     进度记在「线路」上（同一部番不同线路/集数各记各的）。
     临时直链（不属于 a.sources 的对象）只在内存里，不落盘。 */
  let srcPersisted = !!(a && Array.isArray(a.sources) && a.sources.indexOf(srcObj) >= 0);
  let savedPosSec = (srcObj && Number(srcObj.posSec)) || null;
  let lastSavedPos = savedPosSec || 0;
  function persistProgress(force){
    if(!srcPersisted || !a) return;
    const t = video.currentTime;
    if(!t || !Number.isFinite(t)) return;
    if(!force && Math.abs(t - lastSavedPos) < 5) return;
    lastSavedPos = t;
    srcObj.posSec = Math.floor(t);
    persistAnimeQuiet(a);
  }
  const onVisFlush = () => { if(document.hidden) persistProgress(true); };
  document.addEventListener("visibilitychange", onVisFlush);

  function showBadge(text){
    badge.textContent = text;
    badge.classList.add("is-on");
    if(badgeTimer) clearTimeout(badgeTimer);
    badgeTimer = setTimeout(() => badge.classList.remove("is-on"), 620);
  }
  function wake(){
    mountEl.classList.remove("is-idle");
    if(idleTimer) clearTimeout(idleTimer);
    /* 正在拖动或面板打开时不自动隐藏 ——
       Izuko_TV 用 openPopupCount 引用计数做同一件事。 */
    if(!dragging && !panel.classList.contains("is-open")){
      idleTimer = setTimeout(() => mountEl.classList.add("is-idle"), VP.autoHideMs);
    }
  }
  function sleep(){ if(idleTimer) clearTimeout(idleTimer); }
  function togglePlay(){
    if(video.paused){
      /* play() 返回的 Promise 会因自动播放策略而 reject，
         不接住就是一个 Uncaught Promise Rejection。 */
      const pr = video.play();
      if(pr && typeof pr.catch === "function") pr.catch(() => {
        showBadge("浏览器拦截了自动播放，请再点一次");
      });
      center.hidden = true;
      interacted = true;
    }else{
      video.pause();
      center.hidden = false;
    }
    wake();
  }
  function seekBy(ms){
    if(!Number.isFinite(video.duration)) return;
    video.currentTime = Math.max(0, Math.min(video.duration, video.currentTime + ms / 1000));
    showBadge((ms > 0 ? "快进 " : "快退 ") + Math.round(Math.abs(ms) / 1000) + " 秒");
    wake();
  }
  function setRate(r, hint){
    video.playbackRate = r;
    if(bRate) bRate.textContent = r.toFixed(1) + "×";
    if(hint !== false) showBadge(r.toFixed(1) + "×");
    wake();
  }
  /* 长按加速斜坡。
     斜坡的作用是「按得越久走得越快」，用固定的 90ms 定时器推进，
     而不是依赖 keydown 的重复事件 —— 系统给的重复间隔在不同机器上
     从 30ms 到 200ms 不等，会让加速曲线完全走样。
     上限由 scrubStepMillis 的短片保护决定：3 分钟 PV 上不加速，
     两小时电影上能到 12×。 */
  function startRamp(){
    if(rateBack != null) return;
    rateBack = video.playbackRate;
    let repeats = 0;
    rateTimer = setInterval(() => {
      repeats++;
      const step = scrubStepMillis((video.duration || 0) * 1000, repeats);
      /* 步长封顶时长即意味着「再按也走不动了」，
         用它反推倍速上限：长片能到 12×，短片停在起步倍率。 */
      const speedup = Math.min(step / VP.seekStepMs, VP.maxRampSpeed);
      const r = Math.max(rateBack, Math.min(rateBack * speedup, rateBack * VP.holdSpeed));
      video.playbackRate = r;
      if(bRate) bRate.textContent = r.toFixed(1) + "×";
      rateHint.textContent = "加速 " + r.toFixed(1) + "×（松开恢复）";
      rateHint.classList.add("is-on");
    }, 90);
  }
  function endRamp(){
    if(rateTimer){ clearInterval(rateTimer); rateTimer = null; }
    if(rateBack != null){ video.playbackRate = rateBack; setRate(rateBack, false); rateBack = null; }
    rateHint.classList.remove("is-on");
    wake();
  }

  /* ---- 进度同步 ---- */
  function paint(){
    /* 拖动中 timeupdate（约 4Hz）会用真实播放位置覆盖拖动预览，
       进度点在鼠标和播放位置之间来回跳 —— 拖动期间让位。 */
    if(dragging) return;
    const d = video.duration;
    const pct = Number.isFinite(d) && d > 0 ? (video.currentTime / d) * 100 : 0;
    fill.style.width = pct + "%";
    knob.style.left = pct + "%";
    let buffered = 0;
    try{ if(video.buffered.length) buffered = video.buffered.end(video.buffered.length - 1); }catch(e){}
    const bpct = Number.isFinite(d) && d > 0 ? (buffered / d) * 100 : 0;
    buf.style.width = bpct + "%";
    time.textContent = fmtClock(video.currentTime) + " / " + (Number.isFinite(d) ? fmtClock(d) : "--:--");
    track.setAttribute("aria-valuenow", String(Math.round(video.currentTime)));
    track.setAttribute("aria-valuemax", String(Number.isFinite(d) ? Math.round(d) : 0));
  }
  video.addEventListener("timeupdate", () => { paint(); persistProgress(false); });
  video.addEventListener("progress", paint);
  video.addEventListener("loadedmetadata", () => {
    paint();
    /* 续播：只在有记录且记录位置离结尾还远时恢复。
       靠得太近就恢复的话，一播出来就立刻结束并触发自动下一集，
       用户看到的是「刚点播放就被跳走」。Animeko 在 EpisodeHistory
       里也是同一个判断（isFinished 就当没看过）。
       注意单位：finishThresholdMs 是毫秒，时长是秒 —— 不除以 1000
       的话阈值等于 83 分钟，几乎所有正常续播都会被误判成「快看完」。 */
    if(a && Number.isFinite(savedPosSec) && savedPosSec > 5){
      const d = video.duration;
      if(!(Number.isFinite(d) && d - savedPosSec < VP.finishThresholdMs / 1000)){
        try{ video.currentTime = savedPosSec; showBadge("已续播到 " + fmtClock(savedPosSec)); }catch(e){}
      }
    }
  });
  video.addEventListener("play", () => { center.hidden = true; interacted = true; wake(); });
  /* pause 不落盘：pause 事件异步到达，switchTo 换完 srcObj 后旧视频的
     pause 才到，会把旧线路的进度写到新线路上。
     落盘点是 timeupdate（5 秒节流）+ visibilitychange + destroy，够密。 */
  video.addEventListener("pause", () => { center.hidden = false; wake(); });
  video.addEventListener("volumechange", () => {
    btnMute.classList.toggle("is-on", video.muted || video.volume === 0);
  });
  video.addEventListener("error", () => {
    const err = video.error;
    const msg = err && err.code === 4
      ? "这个地址不是浏览器能直接播放的格式（或跨域被拒）。用「选源」换一条，或点「新标签打开」。"
      : "播放失败。请换一条线路，或用「新标签打开」在站外观看。";
    showBadge("播放失败");
    if(onLineChange) onLineChange({ failed:true, message:msg });
  });

  /* 片尾自动下一集。
     守卫「必须已经 interacted」不可省：<video> 在首次加载时会派发一次
     ended（duration 尚未就绪），不过滤就会一打开就跳走。 */
  video.addEventListener("ended", () => {
    if(!interacted || !a) return;
    const d = video.duration;
    if(!(Number.isFinite(d) && d - video.currentTime < VP.finishThresholdMs * 2 / 1000)) return;
    /* 看完的线路清掉续播点：留着的话下次一播就停在结尾 */
    if(srcPersisted && srcObj.posSec != null){ srcObj.posSec = null; persistAnimeQuiet(a); }
    const total = Number(a.totalEpisodes) || 0;
    /* 集数以「当前线路声明的集数」为准，没有才回落到已看集数 ——
       用 a.watchedEpisodes 直接推会在「声明看到第 3 集但已看 12 集」时跳到 13，
       而用户此刻正在看第 3 集的下一步。 */
    const next = currentEpisodeOf(a) + 1;
    if(next <= total){
      showBadge("即将播放第 " + next + " 集");
      if(onLineChange) onLineChange({ autonext:next });
    }
  });

  /* ---- 交互 ---- */
  btnPlay.addEventListener("click", togglePlay);
  center.addEventListener("click", togglePlay);
  btnMute.addEventListener("click", () => {
    video.muted = !video.muted;
    wake();
  });
  bBack.addEventListener("click", () => seekBy(-VP.seekStepMs));
  bFwd.addEventListener("click", () => seekBy(VP.seekStepMs));
  bRate.addEventListener("click", () => {
    /* 连续区间而非离散档位：0.5 – 2.5 步进 0.25。
       Animeko 用连续区间是刻意的，离散档位在 1.0 附近会跳得很难受。 */
    const steps = [0.5,0.75,1,1.25,1.5,1.75,2,2.5];
    const i = steps.findIndex(x => Math.abs(x - video.playbackRate) < 0.01);
    setRate(steps[(i + 1) % steps.length]);
  });
  bFull.addEventListener("click", () => {
    if(document.fullscreenElement) document.exitFullscreen();
    else if(mountEl.requestFullscreen) mountEl.requestFullscreen().catch(() => {});
    wake();
  });
  bOpen.addEventListener("click", () => {
    window.open(srcObj.url, "_blank", "noopener,noreferrer");
  });

  function posFromEvent(e){
    const r = track.getBoundingClientRect();
    const x = (e.touches ? e.touches[0].clientX : e.clientX) - r.left;
    const ratio = Math.max(0, Math.min(1, x / Math.max(1, r.width)));
    return ratio;
  }
  function seekTo(ratio){
    if(!Number.isFinite(video.duration)) return;
    video.currentTime = ratio * video.duration;
    paint();
    wake();
  }
  track.addEventListener("pointerdown", e => {
    dragging = true;
    sleep();
    try{ track.setPointerCapture(e.pointerId); }catch(err){}
    seekTo(posFromEvent(e));
  });
  track.addEventListener("pointermove", e => {
    if(!dragging) return;
    const ratio = posFromEvent(e);
    /* 拖动时只改填充不 seek：每动一下就跳一次，音画会反复重同步。 */
    fill.style.width = (ratio * 100) + "%";
    knob.style.left = (ratio * 100) + "%";
    if(Number.isFinite(video.duration)) time.textContent = fmtClock(ratio * video.duration) + " / " + fmtClock(video.duration);
  });
  track.addEventListener("pointerup", e => {
    if(!dragging) return;
    dragging = false;
    try{ track.releasePointerCapture(e.pointerId); }catch(err){}
    seekTo(posFromEvent(e));
    wake();
  });
  track.addEventListener("keydown", e => {
    if(e.key === "ArrowRight"){ seekBy(VP.seekStepMs); e.preventDefault(); }
    if(e.key === "ArrowLeft"){ seekBy(-VP.seekStepMs); e.preventDefault(); }
  });

  /* 空格的两段语义：轻点启停，按住临时加速。
     关键在时序：keydown 先记住时刻并开始加速计时，keyup 时看按了多久 ——
     短于阈值算「点一下」执行启停，长于阈值则已经在加速，只恢复倍速不再启停。
     若把启停放在 keydown，长按加速的起点会先跳一下播放状态，手感是断的；
     若放在 keyup 且不看时长，则按住不放永远等不到启停。
     阈值取 250ms：短于它时用户主观上就是「点」，长于它主观上就是「按住」。 */
  const SPACE_HOLD_MS = 250;
  let spaceDownAt = 0;
  mountEl.addEventListener("keydown", e => {
    const k = e.key;
    if(k === "ArrowRight"){ seekBy(VP.seekStepMs); e.preventDefault(); }
    else if(k === "ArrowLeft"){ seekBy(-VP.seekStepMs); e.preventDefault(); }
    else if(k === "ArrowUp" || k === "ArrowDown"){ wake(); e.preventDefault(); }
    else if(k === " "){
      if(!e.repeat && spaceDownAt === 0){ spaceDownAt = Date.now(); startRamp(); }
      e.preventDefault();
    }
    else if(k === "Enter"){ togglePlay(); e.preventDefault(); }
    else if(k === "f" || k === "F"){ bFull.click(); }
    else if(k === "Escape" && panel.classList.contains("is-open")){ panel.classList.remove("is-open"); bSrc.classList.remove("is-on"); }
  });
  mountEl.addEventListener("keyup", e => {
    if(e.key !== " " || spaceDownAt === 0) return;
    const held = Date.now() - spaceDownAt;
    spaceDownAt = 0;
    endRamp();
    if(held < SPACE_HOLD_MS) togglePlay();
  });
  /* 焦点离开时清掉按住状态：否则用户按住空格切走窗口，
     回来再松开会被判成一次「点」，莫名暂停。 */
  mountEl.addEventListener("blur", () => {
    if(spaceDownAt !== 0){ spaceDownAt = 0; endRamp(); }
  });

  /* 鼠标移动唤出、静止后自动隐藏 */
  mountEl.addEventListener("mousemove", wake);
  mountEl.addEventListener("mouseleave", () => {
    if(!video.paused && !panel.classList.contains("is-open")){
      mountEl.classList.add("is-idle");
    }
  });

  /* ---- 选源面板 ---- */
  function renderSourcePanel(){
    const list = sourcesOf(a);
    const cur = list.find(s => {
      const act = activeSourceOf(a);
      return act && s.id === act.id;
    }) || null;
    /* 集数筛选以当前线路声明为准；没有声明就不筛 ——
       整季通用的线路不该因为用户在看第 5 集而被判「集数不匹配」。 */
    const wantEp = cur && cur.ep != null ? cur.ep : null;
    const entries = filterSources(list, { showExcluded:true, wantEp:wantEp });
    const body = panel.querySelector("#vp-src-body");
    const hint = panel.querySelector("#vp-src-hint");
    if(hint) hint.textContent = list.length ? ("共 " + entries.filter(x => x.state === "included").length + " / " + list.length + " 条可用") : "尚未添加线路";
    if(!list.length){
      body.innerHTML = '<p class="small muted" style="padding:var(--sp-3)">还没有播放源。在下方「播放地址」里粘一个网址即可添加。</p>';
      return;
    }
    body.innerHTML = '<div class="vsrc-row">' + entries.map(x => {
      if(x.state === "excluded"){
        return '<span class="vsrc is-off has-reason" title="' + attr(x.reasonText || "不可用") + '">' +
          '<span class="vsrc-name"><span class="vsrc-dot"></span>' +
          esc(x.original.name || "未命名") + "</span>" +
          '<span class="vsrc-reason">' + esc(x.reasonText || "不可用") + "</span></span>";
      }
      const s = x.src;
      const on = cur && s.id === cur.id;
      const meta = [s.resolution, s.ep != null ? ("第 " + s.ep + " 集") : null]
        .filter(Boolean).join(" · ");
      return '<button class="vsrc' + (on ? " is-on" : "") + '" type="button" data-src-id="' + attr(s.id) + '">' +
        '<span class="vsrc-name">' + (on ? ic("target",12) : '<span class="vsrc-dot"></span>') +
        esc(s.name || "线路") +
        (meta ? '<span class="vsrc-meta">' + esc(meta) + "</span>" : "") + "</span></button>";
    }).join("") + "</div>";
    body.querySelectorAll("[data-src-id]").forEach(b => b.addEventListener("click", () => {
      const id = b.dataset.srcId;
      const target = list.find(s => s.id === id);
      if(!target || !a) return;
      /* 与胶囊列表同一条路：setActiveSource 会同步旧字段并走静默落盘。
         旧代码直接 saveAnime，会把 updatedAt 刷成现在，
         正在播时切一条线路就被顶到「最近添加」最前。 */
      setActiveSource({ anime:a, source:target });
      panel.classList.remove("is-open");
      bSrc.classList.remove("is-on");
      if(onLineChange) onLineChange({ switchTo:target });
      toast("已切到「" + (target.name || "线路") + "」", "ok");
    }));
  }
  bSrc.addEventListener("click", () => {
    const open = !panel.classList.contains("is-open");
    panel.classList.toggle("is-open", open);
    bSrc.classList.toggle("is-on", open);
    if(open) renderSourcePanel();
    wake();
  });
  panel.querySelector('[data-vp="panel-close"]').addEventListener("click", () => {
    panel.classList.remove("is-open");
    bSrc.classList.remove("is-on");
    wake();
  });

  /* 初始呈现 */
  btnMute.classList.toggle("is-on", video.muted || video.volume === 0);
  setRate(1, false);
  paint();
  wake();
  if(savedPosSec) showBadge("按播放继续");

  return {
    video:video,
    /* 切线路：不停整个播放器，只换 src 并保留进度语义。 */
    switchTo:function(next){
      persistProgress(true);   /* 旧线路的进度在换 src 前落盘，currentTime 马上就没了 */
      try{ video.pause(); }catch(e){}
      srcObj = next;
      srcPersisted = !!(a && Array.isArray(a.sources) && a.sources.indexOf(next) >= 0);
      savedPosSec = (next && Number(next.posSec)) || null;
      lastSavedPos = savedPosSec || 0;
      video.src = next.url;
      title.querySelector("b").textContent = next.name || "播放";
      const metaEl = title.querySelector("span");
      if(metaEl) metaEl.textContent = next.resolution || "";
      interacted = false;
      center.hidden = true;
      video.load();
      /* 换源后自动起播：用户点「切线路」就是想看它，站在这不动是错的。 */
      const pr = video.play();
      if(pr && typeof pr.catch === "function") pr.catch(() => {});
    },
    getPositionSec:() => video.currentTime,
    destroy:function(){
      persistProgress(true);   /* 关页/换页前的最后一笔 */
      document.removeEventListener("visibilitychange", onVisFlush);
      if(idleTimer) clearTimeout(idleTimer);
      if(badgeTimer) clearTimeout(badgeTimer);
      endRamp();
      try{ video.pause(); }catch(e){}
      video.removeAttribute("src");
      try{ video.load(); }catch(e){}
      mountEl.innerHTML = "";
    }
  };
}
/* 把声明的集数写回地址。分 P 制（B 站）能对上就改 p=，
 * 其余平台原样返回 —— 改不了总比改错好。 */
function applyEpToURL(raw, ep){
  const u = normalizeStreamURL(raw);
  if(!u || ep == null) return u;
  try{
    const url = new URL(u);
    if(/(^|\.)bilibili\.com$/i.test(url.hostname)){
      /* 番剧页（bangumi/play/ep*、ss*）用 ?ep=N，普通投稿视频用 ?p=N。
         写错参数名不会报错，只是静默不生效 —— 用户会以为功能坏了。 */
      url.searchParams.set(bilibiliSeasonId(u) ? "ep" : "p", String(ep));
      return url.href;
    }
  }catch(e){}
  return u;
}
/* 已保存线路的列表（详情页播放源面板内）。
   抽成独立函数是因为选完线路后要就地重渲这块 ——
   整页重渲会把播放器一起销毁，正在播的时候换线路就变成从头开始。
   胶囊的高亮与状态条必须由同一次渲染产生，
   分别维护两份 DOM 状态迟早会出现「标签写着使用中、胶囊没高亮」。 */
function linePickerHTML(a){
  const list = sourcesOf(a);
  if(!list.length) return "";
  const act = activeSourceOf(a);
  const hasPlay = list.some(s => !sourceIsSearch(s));
  return '<div class="line-picker mt-3" id="st-lines">' +
    '<div class="line-picker-head"><span class="hint">已保存 ' + list.length + " 条线路" +
    (list.length > 1 ? (hasPlay ? "，点一下设为使用中，双击直接播放" : "") : "") +
    (list.some(sourceIsSearch) && list.length > 1 ? " · 搜索型点一下带着片名去站里搜" : "") + "</span>" +
    (a ? '<button class="btn btn-sm" type="button" data-st="manage">去管理</button>' : "") +
    "</div>" +
    '<div class="vsrc-row">' + list.map(s => {
      const on = act && s.id === act.id;
      const usable = sourceUsable(s);
      const why = usable ? "" : sourceUnusableReason(s);
      /* 搜索型的胶囊不该长得和可播放线路一样：
         它点下去是「跳出去搜」，不是「设为使用中/播放」，
         图标与副标必须在点之前就把这个差别说清。 */
      const meta = sourceIsSearch(s)
        ? "搜《" + esc(searchKeywordFor(a) || "片名") + "》"
        : [s.resolution, s.ep != null ? ("第 " + s.ep + " 集") : "整季"].filter(Boolean).join(" · ");
      /* 不可用的线路照样可点：用户可能只是想把它设成默认
         （比如先标记失效，回头修好再启用），直接 disabled 会让人以为改不了。
         所以只明确写出「为什么它不会被自动选中」。 */
      return '<button class="vsrc' + (on ? " is-on" : "") + (usable ? "" : " is-off has-reason") +
        '" type="button" data-st="line" data-st-line="' + attr(s.id) + '"' +
        (usable ? "" : ' title="' + attr(why) + '"') + ">" +
        '<span class="vsrc-name">' +
        (sourceIsSearch(s) ? ic("search",12) : (on ? ic("target",12) : '<span class="vsrc-dot"></span>')) +
        esc(s.name || sourceDisplayName(s)) +
        (meta ? '<span class="vsrc-meta">' + esc(meta) + "</span>" : "") +
        "</span>" +
        (usable ? "" : '<span class="vsrc-reason">' + esc(why) + "</span>") +
        "</button>";
    }).join("") + "</div></div>";
}
/* 把线路列表就地重画。事件是委托的，新生成的按钮不需要重新绑定。 */
function refreshLinePicker(root, a){
  const box = root.querySelector("#st-lines");
  if(!box) return;
  box.outerHTML = linePickerHTML(a);
}
function renderStreamLauncher(a){
  const list = sourcesOf(a);
  const act = activeSourceOf(a);
  const has = !!act;
  const ep = act && act.ep != null ? act.ep : null;
  /* 线路一览：让「有几条、哪条在用」一眼可见，而且**当场就能换**。
     只存不看等于把选择成本从「保存时一次」推到「每次播放时一次」——
     用户根本记不清自己上次存的是哪条。
     原来的实现是一行文字「已保存 N 条，当前使用 X，播放时点控制条上的『选源』切换」，
     但播放器要点「播放」才出现，等于要求用户先起播一次才能改默认线路；
     而「我下次就想看这条」是保存时的决策，不该被播放动作卡住。 */
  const lineList = list.length ? linePickerHTML(a) : "";
  /* 失效与停用的条数：这两类线路仍然占着选源列表，
     不提示的话用户会以为「保存了 N 条就等于有 N 条能用」。 */
  const badCount = list.filter(s => !sourceUsable(s)).length;
  /* 文案必须包含搜索型：badCount 现在把它算在内，
     而它既没停用也没失效，说「已被停用或标记失效」是错的。 */
  const warnBox = badCount && list.length > 1
    ? '<div class="note-box is-warn mt-3">' + ic("warning",16) +
      "<span>其中 " + badCount + " 条不会在播放时自动选中（已停用、已失效，或只是「搜索型」站点入口）。" +
      '<button class="btn btn-sm" type="button" data-st="manage">去管理</button></span></div>'
    : "";
  return '<div class="panel stream-panel mt-4"><div class="panel-head">' + ic("film",16) +
    "<h3>播放源</h3>" +
    '<span class="hint">' + (a ? "按这部作品保存，换番不会互相覆盖" : "临时片源（未选作品）") + "</span></div>" +
    '<p class="small muted mb-3">粘一个播放网址（YouTube / 哔哩哔哩 / Vimeo，或任意允许嵌入的网站）。' +
    "直链（mp4 / webm）会在站内原生播放，支持续播、倍速与键盘控制；其余站点走内嵌播放器。" +
    "B 站的番剧播放页（<code>bilibili.com/bangumi/play/...</code>）会自动换算成可播放地址。" +
    "同一部作品可以存多条线路，播放时一键切换。<br>" +
    "也可以只粘<b>站点首页</b>（如 <code>www.bilibili.com</code>）：存成搜索型片源后，" +
    "点它会带着这部番的名字去该站搜索 —— 适合「这个站能看，但不想每次都去找具体页面」。</p>" +
    '<div class="row gap-2" style="flex-wrap:wrap">' +
      '<div class="search-wrap" style="flex:1 1 320px;max-width:none">' + ic("link",16) +
        '<input class="input" id="st-url" type="url" inputmode="url" spellcheck="false" ' +
        'placeholder="番剧页 / 视频页 / youtu.be 链接都可以" value="">' +
      "</div>" +
      '<div class="field" style="flex:0 0 132px"><label for="st-ep">看到第几集</label>' +
        '<input class="input" id="st-ep" type="number" inputmode="numeric" min="1" step="1" ' +
        'placeholder="—" value="' + (ep == null ? "" : ep) + '"></div>' +
      '<div class="field" style="flex:0 0 152px"><label for="st-name">线路名称</label>' +
        '<input class="input" id="st-name" type="text" maxlength="24" placeholder="留空按网址命名"></div>' +
    "</div>" +
    '<div class="row gap-2 mt-3" style="flex-wrap:wrap">' +
      '<button class="btn btn-primary" type="button" data-st="add">' + ic("plus",14) + "添加线路</button>" +
      (has ? '<button class="btn" type="button" data-st="play">' + ic("play",14) + "播放</button>" : "") +
      (has ? '<button class="btn" type="button" data-st="open">' + ic("external",14) + "新标签打开</button>" : "") +
      (list.length > 1 ? '<button class="btn" type="button" data-st="clear-one">清除当前线路</button>' : "") +
      (list.length > 1 ? '<button class="btn btn-sm" type="button" data-st="clear">清除全部</button>' : "") +
      (a ? '<button class="btn btn-sm" type="button" data-st="manage">' + ic("link",14) + "播放源管理</button>" : "") +
    "</div>" + lineList + warnBox +
    /* 状态条在两种形态下都必须存在（带 id="st-status"）：
       bindStreamLauncher 的 setStatus 只往这个 id 写。
       缺了它，用户看到的就只有静态提示，出错了也不知道。 */
    (has
      ? '<div id="st-status" class="note-box is-ok mt-3">' + ic("check",16) + "<span>当前线路：" + esc(act.name || "线路") +
        (ep != null ? " · 第 " + esc(String(ep)) + " 集" : "") + "</span></div>"
      : '<div id="st-status" class="note-box is-warn mt-3">' + ic("info",16) +
        "<span>尚未保存。多数网站禁止被第三方网站嵌入，遇到白屏属正常现象，用「新标签打开」总能观看。</span></div>") +
    '<div id="st-mount" class="stream-mount mt-3" hidden></div>' +
  "</div>";
}
/* 清除按钮的显示不能只看渲染那一刻的持久化状态：
   用户常常是「先粘网址 → 才想到添加」，此时页面并未重渲染，
   按钮就永远不出现。改为依据输入框实时取值。 */
function syncStreamLauncher(root){
  const input = root.querySelector("#st-url");
  const addBtn = root.querySelector('[data-st="add"]');
  const has = !!(input && input.value.trim());
  if(addBtn) addBtn.disabled = false;
  /* 没有已保存线路时，「播放」不该可点：点了只能靠输入框里的临时值，
     播完就没了，用户会以为保存失败。 */
  ["play","open"].forEach(k => {
    const b = root.querySelector('[data-st="' + k + '"]');
    if(b) b.disabled = !has && k === "open";
  });
}
/* 把输入框内容追加为一条新线路（不覆盖已有线路）。 */
async function addSourceFromInput(root, a){
  const input = root.querySelector("#st-url");
  const epInput = root.querySelector("#st-ep");
  const nameInput = root.querySelector("#st-name");
  if(!input) return null;
  const raw = input.value.trim();
  if(!raw){ showLauncherError(root, "请先填一个播放网址"); return null; }
  const epRaw = epInput ? epInput.value.trim() : "";
  let ep = null;
  if(epRaw !== ""){
    ep = Number(epRaw);
    if(!Number.isInteger(ep) || ep < 1){ showLauncherError(root, "集数必须是大于 0 的整数"); return null; }
  }
  const norm = normalizeStreamURL(raw);
  /* 这里只校验「是不是安全的 http(s) 网址」，绝不能要求 resolveEmbed 成功 ——
     存网址和能不能在页内播放是两件事。把前者绑死在后者上，
     等于因为播放器不支持而剥夺用户保存自己资料的能力。
     用户明确说过「连保存都不行」。 */
  if(!norm){ showLauncherError(root, "网址无效：只接受 http / https 开头的地址"); return null; }
  if(!a){ showLauncherError(root, "请先从片库打开一部作品，再添加播放源"); return null; }
  migrateSources(a);
  const now = new Date().toISOString();
  /* 站点首页：先问一句「要不要存成搜索型」。
     放在重复检测之前 —— 用户粘首页的意图几乎不可能是「存一个播不了的地址」，
     先把这条路给出来，比存完再让他想「为什么点播放没反应」好。 */
  if(isSiteHome(norm)){
    const choice = await promptSiteSource(norm, a);
    if(!choice) return null;                       // 取消：什么都不存
    if(choice.mode === "search"){
      const sName = (nameInput && nameInput.value.trim()) || siteLabelOf(norm);
      /* 同一首页的搜索型不重复攒（与下方普通线路的同址判重对称）：
         已存在时改为更新它的搜索模板，而不是再存一条一模一样的。 */
      const existed = (a.sources || []).find(s => s.kind === "search" && s.url === norm);
      if(existed){
        const tplChanged = !!(choice.tpl && existed.searchUrl !== choice.tpl);
        if(tplChanged){ existed.searchUrl = choice.tpl; await saveAnime(a); }
        input.value = "";
        if(nameInput) nameInput.value = "";
        return { source:existed, duplicate:true, search:true, tplUpdated:tplChanged };
      }
      const srcS = normalizeSource(
        { url:norm, name:sName, kind:"search", searchUrl:choice.tpl, savedAt:now },
        (a.sources || []).length, now);
      if(!srcS){ showLauncherError(root, "网址无效"); return null; }
      a.sources.push(srcS);
      /* 刻意**不改** activeSourceId / streamUrl：搜索型不能播，
         设成当前线路会让播放区显示「当前线路：XX」却点不出画面。 */
      await saveAnime(a);
      input.value = "";
      if(nameInput) nameInput.value = "";
      return { source:srcS, duplicate:false, search:true };
    }
    /* mode === "plain"：尊重用户，按普通线路继续往下存。 */
  }
  /* 同址不重复添加：反复点「添加」会攒出一串一模一样的线路，
     选源面板里全是重复项。提示已有而不是静默跳过。
     只在普通线路之间判重 —— 用户刚在弹窗里明确选了「仍按普通线路保存」，
     不能因为同址有一条搜索型就把他的选择吞掉；两种形态共存是有意义的。
     dup 也因此绝不可能是搜索型，下面设 activeSourceId 不破坏
     「搜索型不能当当前线路」的不变量。 */
  const dup = (a.sources || []).find(s => s.kind !== "search" && s.url === norm && (s.ep == null || ep == null || s.ep === ep));
  if(dup){
    a.activeSourceId = dup.id;
    await saveAnime(a);
    input.value = "";
    if(nameInput) nameInput.value = "";
    if(epInput) epInput.value = "";
    return { duplicate:true, source:dup };
  }
  const name = (nameInput && nameInput.value.trim()) || "";
  const src = normalizeSource({ url:norm, ep:ep, name:name, savedAt:now }, (a.sources || []).length, now);
  if(!src) { showLauncherError(root, "网址无效"); return null; }
  a.sources.push(src);
  a.activeSourceId = src.id;
  /* 兼容旧字段：详情页与待机屏仍有读streamEp 的地方。
     不写的话「看到第几集」会在换页后丢一次，用户会以为没保存。 */
  a.streamUrl = src.url;
  a.streamEp = src.ep;
  a.streamUrlAt = now;
  await saveAnime(a);
  input.value = "";
  if(nameInput) nameInput.value = "";
  if(epInput) epInput.value = "";
  return { source:src, duplicate:false };
}
function showLauncherError(root, msg){
  const el = root.querySelector("#st-status");
  if(!el) return;
  el.className = "note-box mt-3 is-err";
  el.innerHTML = ic("warning",16) + "<span>" + esc(msg) + "</span>";
}

/* ---- 站点首页 → 搜索型片源 ----
   粘进来的是站点首页时问一句搜索模板。
   模板必须是**用户看得见、改得动**的：不同站的搜索路由五花八门，
   猜错了用户面对的是「搜不出来」，而他根本不知道我们拼了什么 URL。 */
function promptSiteSource(home, a){
  const cands = searchCandidates(home);
  return new Promise((resolve) => {
    const root = openModal({
      title:"这是站点首页",
      narrow:true,
      body:
        '<p class="hint mb-3">' + esc(home) + ' 是站点首页，没有具体播放页。<br>' +
        '存成<b>搜索型片源</b>：以后点它，会用这部番的名字在这个站里搜索。</p>' +
        '<div class="field mb-3"><label for="ps-tpl">搜索网址模板（<code>{kw}</code> 会被替换成片名）</label>' +
          '<input class="input" id="ps-tpl" data-autofocus value="' + attr(cands[0] || home) + '"></div>' +
        (cands.length > 1
          ? '<div class="row gap-2 mb-3" style="flex-wrap:wrap">' + cands.map((c, i) =>
              '<button class="btn btn-sm" type="button" data-cand="' + attr(c) + '">' + esc(c.replace(/^https?:\/\//, "")) + "</button>").join("") + "</div>"
          : "") +
        '<div class="hint">多数站点的搜索就是一次 GET，把关键词放进网址即可。' +
        '少数站用前端路由（# 后面带参数），把 <code>#/search?keyword={kw}</code> 这类地址贴进上面即可。</div>',
      footer: (f) => {
        f.innerHTML =
          '<button class="btn btn-sm" type="button" id="ps-plain">仍按普通线路保存</button>' +
          '<div class="grow"></div>' +
          '<button class="btn" type="button" id="ps-cancel">取消</button>' +
          '<button class="btn btn-primary" type="button" id="ps-try">试搜一下</button>' +
          '<button class="btn btn-primary" type="button" id="ps-save">存为搜索型</button>';
        /* footer 是在 openModal **内部**同步调用的，此时 `const root` 还没赋值
           （TDZ）—— 回调里直接引用 root 会抛 ReferenceError，
           而且被 openModal 的 try/catch 吞成一句控制台日志，
           表现是「弹窗出来了但按钮全死」。一律走 document 取元素。 */
        const tplVal = () => { const n = document.querySelector("#ps-tpl"); return n ? n.value.trim() : ""; };
        document.querySelectorAll("[data-cand]").forEach(b => b.addEventListener("click", () => {
          const n = document.querySelector("#ps-tpl"); if(n) n.value = b.dataset.cand;
        }));
        f.querySelector("#ps-cancel").addEventListener("click", () => { closeModal(); resolve(null); });
        f.querySelector("#ps-plain").addEventListener("click", () => { closeModal(); resolve({ mode:"plain" }); });
        /* 试搜：真开一个标签让用户确认搜出来是对的。
           这一步不能省 —— 模板对不对，只有对方的搜索结果页能证明。 */
        f.querySelector("#ps-try").addEventListener("click", () => {
          const url = buildSearchUrl(tplVal(), a ? searchKeywordFor(a) : "测试");
          if(url) window.open(url, "_blank", "noopener,noreferrer");
        });
        f.querySelector("#ps-save").addEventListener("click", () => {
          const t = tplVal();
          if(!t){ toast("请填一个搜索网址模板", "warn"); return; }
          closeModal();
          resolve({ mode:"search", tpl:t });
        });
      }
    });
  });
}
/* 打开搜索：确认关键词（可改）后在新标签打开结果页。
   关键词必须摆出来让用户改：番的中文名未必是站里收录用的名字
   （译名差异很大），不改的话「搜不到」会被误判成站点坏了。 */
function openSiteSearch(a, s){
  if(!a || !sourceIsSearch(s)) return Promise.resolve(null);
  const kw = searchKeywordFor(a);
  return new Promise((resolve) => {
    const root = openModal({
      title:"在「" + (s.name || sourceDisplayName(s)) + "」里搜索",
      narrow:true,
      body:
        '<p class="hint mb-3">搜索型片源没有播放地址：这里把片名拼进该站的搜索网址，' +
        '在新标签里直接给到搜索结果页。</p>' +
        '<div class="field mb-3"><label for="ss-kw">搜索关键词</label>' +
          '<input class="input" id="ss-kw" data-autofocus value="' + attr(kw) + '"></div>' +
        '<div class="field"><label for="ss-url">将打开的网址</label>' +
          '<input class="input" id="ss-url" readonly value=""></div>',
      footer: (f) => {
        f.innerHTML =
          '<button class="btn btn-sm" type="button" id="ss-copy">复制片名</button>' +
          '<div class="grow"></div>' +
          '<button class="btn" type="button" id="ss-cancel">取消</button>' +
          '<button class="btn btn-primary" type="button" id="ss-go">' + ic("search",14) + "打开搜索</button>";
        /* 同上：footer 在 openModal 里同步执行，这里不能引用 root。 */
        const kwEl = document.querySelector("#ss-kw");
        const urlEl = document.querySelector("#ss-url");
        const sync = () => { if(kwEl && urlEl) urlEl.value = buildSearchUrl(s.searchUrl, kwEl.value); };
        bindIMEInput(kwEl, sync);
        sync();
        f.querySelector("#ss-cancel").addEventListener("click", () => { closeModal(); resolve(null); });
        f.querySelector("#ss-copy").addEventListener("click", async () => {
          const txt = kwEl.value.trim() || kw;
          try{
            await navigator.clipboard.writeText(txt);
            toast("已复制片名：" + txt, "ok");
          }catch(e){ toast("浏览器不允许复制，请手动选中复制", "warn"); }
        });
        f.querySelector("#ss-go").addEventListener("click", () => {
          const url = buildSearchUrl(s.searchUrl, kwEl.value);
          closeModal();
          if(url) window.open(url, "_blank", "noopener,noreferrer");
          resolve(url || null);
        });
      }
    });
  });
}
/* 放映厅视图的监听器句柄。renderDetail / renderStandby 每次导航都会
   重新调用 bindStreamLauncher，而挂载点 root 始终是同一个 #view。
   原实现用 forEach + addEventListener 逐元素绑定：旧监听器随元素销毁
   「意外」失效，但代价是**就地重画出来的新按钮从未被绑定** ——
   表现为「第一次点能换线路，第二次点就没反应」。

   改成委托后监听器会跨导航累积，而委托处理器闭包捕获的 a 会是
   **第一次绑定时那部作品** —— 在 B 番的详情页点线路，会把 A 番的
   activeSourceId 改掉。这是数据损坏级的 bug。

   所以每次绑定前先 abort 上一次的：既解决重复绑定，
   也让 a / input 闭包跟着本次渲染走。 */
let streamLauncherAbort = null;
function bindStreamLauncher(root, a){
  if(streamLauncherAbort){ streamLauncherAbort.abort(); streamLauncherAbort = null; }
  const ac = new AbortController();
  streamLauncherAbort = ac;
  const sig = { signal:ac.signal };
  const input = root.querySelector("#st-url");
  const mount = root.querySelector("#st-mount");
  if(!input || !mount) return;
  /* vp = 原生播放器句柄；cleanup = iframe 降级路径的清理函数。
     两者互斥：同一时刻只有一种播放形态挂在页面上。 */
  let vp = null;
  let cleanup = null;
  const dropPlayer = () => {
    if(vp){ vp.destroy(); vp = null; }
    if(cleanup){ cleanup(); cleanup = null; }
  };
  /* 状态条定位。
     原先靠 `querySelector(".stream-panel .note-box")` 兜底 ——
     多线路版里面板有多个 note-box（「已保存 N 条线路」「当前线路：…」），
     取第一个会把状态文字写到「当前线路」那条静态提示上，
     于是用户填错集数时看到的仍是「当前线路：线路 1 · 第 7 集」，
     完全看不出哪里错了。兜底必须选对元素，不能选第一个。
     现在状态条在两种形态下都带 id="st-status"，不再需要猜。 */
  function statusEl(){
    return root.querySelector("#st-status");
  }
  function setStatus(kind, text){
    const el = statusEl();
    if(!el) return;
    el.className = "note-box mt-3 " + (kind === "ok" ? "is-ok" : kind === "warn" ? "is-warn" : "is-err");
    el.innerHTML = (kind === "ok" ? ic("check",16) : kind === "warn" ? ic("warning",16) : ic("info",16)) +
      "<span>" + text + "</span>";
  }
  function readEp(){
    const el = root.querySelector("#st-ep");
    const v = el ? el.value.trim() : "";
    if(v === "") return null;
    const n = Number(v);
    return (!Number.isInteger(n) || n < 1) ? NaN : n;
  }
  function effectiveURL(){
    const ep = readEp();
    return applyEpToURL(input.value, ep != null && !isNaN(ep) ? ep : null);
  }
  async function play(){
    const typed = input.value.trim();
    /* 先判「用户到底填了什么」，再判归一化后的地址。
       反过来写会有洞：applyEpToURL 对 javascript: 这类伪协议会归一化成空串，
       于是 !raw 为真但 !typed 为假 —— 条件放行了它，
       提示语还会对着非空输入说「请先填一个播放网址」，用户完全看不懂哪里错了。 */
    const raw = typed ? effectiveURL() : normalizeStreamURL((activeSourceOf(a) || {}).url);
    /* 播放必须能用已保存的线路，不能要求输入框里还有东西。
       输入框的语义是「待添加的新线路」，添加成功后会被清空；
       若播放只认输入框，用户就永远得再粘一次同一个网址才能看片 ——
       那样「保存片源」这个需求等于没实现。 */
    if(!raw){ setStatus("err", typed ? "网址无效：只接受 http / https 开头的地址" : "还没有可播放的线路。请先在上面填一个网址并点「添加线路」。"); return; }
    mount.hidden = false;
    dropPlayer();
    setStatus("warn", "正在准备播放…");
    /* 记一次「最近使用」，走静默落盘 —— 播放不算编辑内容，
       saveAnime 会把老作品顶到「最近添加」最前。只对真正被播放的
       那条已存线路记账：播的是输入框直链时不记在已存线路上。 */
    const savedMatch = a ? (sourcesOf(a) || []).find(s => s && s.url === raw) : null;
    const usedAct = activeSourceOf(a);
    if(a && usedAct && usedAct.url === raw){
      usedAct.lastUsedAt = nowIso();
      persistAnimeQuiet(a);
    }
    /* 直链走原生播放器：能读时间轴，所以续播、倍速、片尾自动下一集都能做。
       判定和挂载必须是同一个地址 —— 输入框里的直链优先；
       它不匹配任何已存线路时用临时对象起播（进度不落盘），
       绝不能静默改播已存的当前线路。 */
    if(isDirectPlayable(raw)){
      const act = savedMatch || normalizeSource({ url:raw }, 0, new Date().toISOString());
      vp = mountVideoPlayer(mount, act, a, evt => {
        if(evt.failed && evt.message) setStatus("err", evt.message);
        if(evt.switchTo && vp){ vp.switchTo(evt.switchTo); }
        if(evt.autonext != null){
          /* 自动下一集：只改声明的集数并重挂，
             换源是用户的选择，不该由系统替他决定。 */
          const cur = activeSourceOf(a);
          if(a && cur){
            cur.ep = evt.autonext;
            a.streamEp = evt.autonext;
            a.watchedEpisodes = Math.max(a.watchedEpisodes || 0, evt.autonext);
            saveAnime(a).then(() => {
              toast("已切到第 " + evt.autonext + " 集的声明", "ok");
              rerender();
            });
          }
        }
      });
      setStatus("ok", "已就绪。空格播放/暂停，←→ 快退进 5 秒，F 全屏。");
      return;
    }
    /* 非直链：番剧要现查接口换 bvid+cid，必须 await。
       不 await 会让 cleanup 在 iframe 建好之前就返回，播放器永远挂不上去。 */
    const fn = await mountStreamPlayer(mount, raw, setStatus);
    /* 换不出来时（典型是 file:// 打开、origin=null 被接口拒绝），
       与其留一个空面板，不如直接把用户送到官方页面。 */
    if(fn && fn.needOfficial && fn.official){
      mount.hidden = true;
      try{ window.open(fn.official, "_blank", "noopener,noreferrer"); }catch(e){}
      setStatus("warn", "已为你打开 B 站官方页面。片源已保存，下次直接续播。");
      return;
    }
    cleanup = fn;
  }
  /* 用委托而不是 forEach + addEventListener：
     线路列表会就地重画（refreshLinePicker 换掉整块 outerHTML），
     逐元素绑定的话重画出来的新按钮全是死的 ——
     表现为「第一次点能换，第二次点就没反应」。
     而且 routeId 切换会复用同一个 root，逐元素绑定还会越堆越多。 */
  root.addEventListener("click", async (e) => {
    const b = e.target.closest("[data-st]");
    if(!b || !root.contains(b)) return;
    const act = b.dataset.st;
    if(act === "add"){
      const r = await addSourceFromInput(root, a);
      if(r){
        /* 名称与片名是外部/手输数据，setStatus 走 innerHTML，必须过 esc */
        setStatus("ok", r.duplicate
          ? (r.search
            ? (r.tplUpdated ? "已更新该站点的搜索模板。" : "该站点的搜索型片源已存在。")
            : "这条线路已经存过了，已切到它。")
          : (r.search
            ? "已存为搜索型片源「" + esc(r.source.name || "站点") + "」：点它用《" + esc(a.titleCn || a.titleOriginal || "片名") + "》在这个站里搜索。"
            : "已添加线路「" + esc(r.source.name || "线路") + "」。"));
        if(!r.duplicate) rerender();
      }
      return;
    }
    if(act === "play"){ await play(); return; }
    /* 线路列表：单击设为使用中，双击顺手起播。
       落盘走 persistAnimeQuiet —— 换默认线路是「整理线路」，
       不该把 updatedAt 刷成现在。
       刻意**不整页重渲**：重渲会把播放器一起销毁，
       正在播的时候换线路就变成了「从头开始」，
       而状态条却说「已换」—— 画面和文字对不上。
       所以只原地更新受影响的几处。 */
    if(act === "line" && a){
      const id = b.dataset.stLine;
      const target = sourcesOf(a).find(s => s.id === id);
      if(!target) return;
      /* 搜索型：点它不是「设为使用中」，是带着片名去站里搜。
         必须在 setActiveSource 之前拦掉 —— 那条路会返回一个
         「已设为使用中，但这条不可用」的提示，等于把搜索型判成坏线路。 */
      if(sourceIsSearch(target)){ await openSiteSearch(a, target); return; }
      const same = a.activeSourceId === id;
      const res = await setActiveSource({ anime:a, source:target });
      if(!res.ok){ setStatus("err", "保存失败，线路没换成"); return; }
      refreshLinePicker(root, a);
      const epInput2 = root.querySelector("#st-ep");
      if(epInput2) epInput2.value = target.ep == null ? "" : String(target.ep);
      if(!res.usable){
        setStatus("warn", "已设为使用中，但这条" + (sourceUnusableReason(target) || "当前不可用") + "，播放时会自动跳过它");
      }else{
        setStatus("ok", (same ? "当前线路：" : "已切到：") + esc(target.name || sourceDisplayName(target)) +
          (target.ep != null ? " · 第 " + target.ep + " 集" : ""));
      }
      /* 正在播就立刻换源；没在播则只改默认线路，等用户点播放。
         用 vp.switchTo 而不是重建播放器 —— 它保留进度语义。
         「双击直接播」由单独的 dblclick 处理，不在这里判断：
         双击会先派发两次 click，在这里播等于开了两次播放器。 */
      if(vp && vp.video && !vp.video.paused && !vp.video.ended){
        vp.switchTo(target);
        toast("已切到「" + (target.name || "线路") + "」", "ok");
      }
      return;
    }
    if(act === "manage"){
      /* 带上作品 id：管理页收到 focusAnime 后自动筛出这部作品，
         省掉用户在几十行台账里翻找这部番的过程。 */
      ledgerState.q = a && (a.titleCn || a.titleOriginal) ? (a.titleCn || a.titleOriginal) : "";
      ledgerState.filter = ""; ledgerState.picked = [];
      go("sources");
      return;
    }
    if(act === "open"){
      const u = normalizeStreamURL(effectiveURL()) || (activeSourceOf(a) || {}).url;
      if(!u){ setStatus("err", "网址无效，无法打开"); return; }
      window.open(u, "_blank", "noopener,noreferrer");
      return;
    }
    if(act === "clear-one" || act === "clear"){
      dropPlayer();
      mount.hidden = true; mount.innerHTML = "";
      if(!a){ settings.stream_url = ""; saveSettings(); syncStreamLauncher(root); setStatus("warn", "已清除临时片源。"); return; }
      migrateSources(a);
      const cur = activeSourceOf(a);
      if(act === "clear-one" && cur){
        a.sources = a.sources.filter(s => s.id !== cur.id);
        setStatus("ok", "已清除「" + esc(cur.name || "线路") + "」。");
      }else{
        a.sources = [];
        a.activeSourceId = "";
        a.streamUrl = ""; a.streamEp = null; a.streamUrlAt = "";
        setStatus("warn", "已清除全部线路。");
      }
      /* 旧字段跟着当前线路走 —— 但只在本作品**还有自己的线路**时。
         清空后 activeSourceOf 会兜到全局 legacy 临时片源（settings.stream_url），
         把它写回 a.streamUrl 等于把刚删掉的线路固化回去：
         重进页面「已清除」的线路又回来了。 */
      const ownLeft = (a.sources || []).filter(s => s && s.url);
      if(ownLeft.length){
        const nx = activeSourceOf(a);
        a.streamUrl = nx ? nx.url : "";
        a.streamEp = nx ? nx.ep : null;
      }else{
        a.streamUrl = ""; a.streamEp = null; a.streamUrlAt = "";
      }
      await saveAnime(a);
      rerender();
      return;
    }
  }, sig);
  input.addEventListener("keydown", e => {
    if(e.key === "Enter"){ e.preventDefault(); play(); }
  }, sig);
  bindIMEInput(input, debounce(() => {
    syncStreamLauncher(root);
    const v = input.value.trim();
    if(!v) return;
    /* 提示改用「能否归一化」而不是「能否内嵌」——
       后者会让番剧页这类合法地址被误报成无法识别。 */
    if(!normalizeStreamURL(v)){ setStatus("err", "这个地址无法识别，只接受 http / https 开头的网址。"); return; }
    if(isDirectPlayable(normalizeStreamURL(v))) setStatus("ok", "识别为直链，可在站内原生播放（支持续播与倍速）。");
    else if(resolveEmbed(v).ok) setStatus("warn", "地址可识别，按「添加线路」保存，点「播放」开始。");
    else if(bilibiliSeasonId(normalizeStreamURL(v))) setStatus("warn", "已识别为 B 站番剧，播放时会自动换算地址。");
    else setStatus("warn", "网址已记录。该网站可能禁止被嵌入，播放无画面时请用「新标签打开」。");
  }, 350), sig);
  /* 双击线路胶囊 = 设为使用中并立刻起播。
     不能靠 click 事件里判断 detail（连点会触发两次），
     dblclick 单独绑在这里 —— 线路列表会就地重画，
     所以用委托挂在 root 上，一次绑定覆盖重画后的新节点。 */
  root.addEventListener("dblclick", async (e) => {
    const b = e.target.closest('[data-st-line]');
    if(!b || !a || !root.contains(b)) return;
    const target = sourcesOf(a).find(s => s.id === b.dataset.stLine);
    if(!target) return;
    /* 搜索型没有可播地址，双击不做事（单击已经把搜索弹窗打开了）。 */
    if(sourceIsSearch(target)) return;
    const res = await setActiveSource({ anime:a, source:target });
    if(!res.ok) return;
    refreshLinePicker(root, a);
    await play();
  }, sig);
  syncStreamLauncher(root);
  /* 切走时务必断开播放器，否则外部站点的音视频会继续在后台播放 */
  window.addEventListener("pagehide", dropPlayer, { once:true });
  /* 上一次绑定留下的监听器在这里一并撤掉：
     播放器不销毁的话，切到别的作品后它还在后台播。 */
  ac.signal.addEventListener("abort", dropPlayer);
}

/* 未选作品时的放映厅。
 *
 * 原先是「语录待机屏保」（CRT 雪花 + 8 秒轮播台词）。用户明确要求去掉 ——
 * 理由站得住：待机的唯一功能是让人路过时看一句台词，但代价是
 * 打开放映厅第一眼看到的不是「要看什么」，而是装饰。
 * 现在直接给一个选片入口，把「选一部」放在第一位。
 * 顶部那颗大屏留给详情页的进度条，比语录有信息量。 */
function renderStandby(root){

  const list = sortAnime(state.anime);
  root.innerHTML = '<div class="panel">' +
    '<div class="panel-head">' + ic("theater",16) + "<h3>选一部看</h3>" +
      '<span class="hint">片源与进度按作品分别保存</span></div>' +
    (list.length
      ? '<div class="pick-grid">' + list.map(a => {
          const n = a.titleCn || a.titleOriginal || "未命名";
          /* 集数与线路数都读当前线路：多线路并存后，
             片库里一眼能看出「这部有 3 条线路」比只写「有片源」有用得多。 */
          const lines = sourcesOf(a);
          const act = activeSourceOf(a);
          const ep = act && act.ep != null ? "看到第 " + act.ep + " 集"
            : (a.streamEp != null ? "看到第 " + a.streamEp + " 集"
            : (a.watchedEpisodes ? "已看 " + a.watchedEpisodes + " 集" : "未开始"));
          const srcTag = lines.length
            ? " · " + lines.length + " 条线路"
            : "";
          return '<button class="pick-card" type="button" data-open="' + attr(a.id) + '">' +
            '<span class="pick-cover">' + coverThumb(a) + "</span>" +
            '<span class="pick-body"><b>' + esc(n) + "</b>" +
            '<span class="small muted">' + esc(ep) + srcTag + "</span></span></button>";
        }).join("") + "</div>"
      : '<div class="state-box">' + ic("library",40) + "<h2>还没有可放映的作品</h2>" +
        '<p>先到片库添加一部动画、片源与观看进度就会留在这里。</p>' +
        '<div class="row"><button class="btn btn-primary" type="button" data-act="goto-lib">去片库添加</button></div></div>') +
    "</div>" +
    renderStreamLauncher(null);
  const b = root.querySelector('[data-act="goto-lib"]');
  if(b) b.addEventListener("click", () => go("library"));
  root.querySelectorAll(".pick-card").forEach(n =>
    n.addEventListener("click", () => go("theater", n.dataset.open)));
  bindStreamLauncher(root, null);
}

function renderDetail(root, id){

  const a = animeById(id);
  if(!a){
    root.innerHTML = '<div class="state-box">' + ic("empty",40) + "<h2>作品不存在</h2>" +
      '<div class="row"><button class="btn btn-primary" type="button" data-act="back">返回放映厅</button></div></div>';
    const b = root.querySelector("[data-act=back]");
    if(b) b.addEventListener("click", () => go("theater"));
    return;
  }
  const p = progressOf(a);
  const name = a.titleCn || a.titleOriginal || "未命名";

  const meta = [];
  if(a.airDate) meta.push("<span>首播 <b>" + esc(a.airDate) + "</b></span>");
  /* 时隔重逢：最近一次观看距首播的年数。语义是「这部作品等了你 N 年」，
     有观看日期与首播年才显示 —— 数据不全时不硬凑。 */
  if(reunionYearsOf(a) != null && reunionYearsOf(a) > 0){
    meta.push('<span class="reunion-tag">' + ic("refresh",13) + " 时隔 <b>" + reunionYearsOf(a) + "</b> 年重逢</span>");
  }
  meta.push("<span>集数 <b>" + (a.totalEpisodes == null ? "未知" : a.totalEpisodes) + "</b></span>");
  if(a.durationMinutes) meta.push("<span>片长 <b>" + a.durationMinutes + " 分钟</b></span>");
  if((a.studios||[]).length) meta.push("<span>公司 <b>" + esc(a.studios.join("、")) + "</b></span>");
  if((a.genres||[]).length) meta.push("<span>类型 <b>" + esc(a.genres.join(" / ")) + "</b></span>");
  if(a.communityScore != null) meta.push('<span>社区分 <b>' + fmtNum(a.communityScore) + "</b></span>");

  const pendingKeys = Object.keys(a.pending || {});
  const reviews = (a.reviews || []).slice().sort((x,y) => String(y.date).localeCompare(String(x.date)));

  /* 结构：详情在上、播放器在下（用户指定的布局）。
     原先整个详情裹在 .crt-frame / .modern-frame 里，而那两层是为
     「待机屏保的大屏」设计的 —— 详情页并不需要。
     留下的只有雪花的 canvas 插槽，现在也没用了，一并去掉。 */
  const html = '<div class="theater">' +
    '<div class="detail-wrap">' +
      '<div class="row gap-3 mb-3">' +
        '<button class="btn btn-sm" type="button" data-act="back">' + ic("rewind",14) + "返回放映厅</button>" +
        '<span class="badge badge-src">' + esc(sourceLabel(a)) + "</span>" +
        '<div class="row" style="margin-left:auto">' +
          '<button class="btn btn-sm ' + (a.favorite ? "is-on" : "") + '" type="button" data-act="fav">' + ic("heart",14) + (a.favorite ? "已收藏" : "收藏") + "</button>" +
          '<button class="btn btn-sm ' + (a.masterpiece ? "is-on" : "") + '" type="button" data-act="master">' + ic("starfill",14) + (a.masterpiece ? "神作" : "标为神作") + "</button>" +
        "</div>" +
      "</div>" +
      '<div class="detail-hero">' +
        '<div class="detail-cover">' + coverImg(a) + "</div>" +
        "<div>" +
          '<h2 class="detail-title">' + esc(name) + "</h2>" +
          (a.titleOriginal && a.titleOriginal !== name ? '<div class="detail-orig">' + esc(a.titleOriginal) + "</div>" : "") +
          ((a.aliases||[]).length ? '<div class="small muted mt-3">别名：' + esc(a.aliases.join("、")) + "</div>" : "") +
          '<div class="detail-meta">' + meta.join("") + "</div>" +
          '<div class="detail-meta">' +
            '<span class="st-dot" style="--st-color:' + esc(statusColor(a)) + '"><i></i><b>' + esc(statusName(a)) + "</b></span>" +
            (a.watchYear ? "<span>看过：<b>" + a.watchYear + " 年" + (a.watchGrade ? " · " + esc(a.watchGrade) : "") + "</b></span>" : "") +
            (a.watchChannel ? "<span>渠道：<b>" + esc(a.watchChannel) + "</b></span>" : "") +
            (a.myScore != null ? '<span class="score-pill mine">' + ic("starfill",11) + "我的评分 " + fmtNum(a.myScore) + "</span>" : "") +
          "</div>" +
        "</div>" +
      "</div>" +

      /* 系列区块：这是「一部动画有多季」这件事唯一真正有用的地方 ——
         在详情页直接看到同系列的其他作品并跳过去，
         而不必回片库按名字搜。 */
      seriesBlockHTML(a) +

      (p === null
        ? '<div class="mt-4 sec-title">' + ic("clock",16) + "<span>进度</span></div>" +
          '<div class="small muted">总集数未知，已看 ' + (a.watchedEpisodes||0) + " 集</div>"
        : '<div class="mt-4 sec-title">' + ic("clock",16) + "<span>观看进度</span><b style=\"margin-left:auto\">" + Math.round(p) + "%</b></div>" +
          '<div class="progress" style="height:10px"><i style="width:' + p + '%"></i></div>' +
          '<div class="small muted mt-3">已看 ' + (a.watchedEpisodes||0) + " / " + a.totalEpisodes + " 集 · 重看 " + (a.rewatchCount||0) + " 次</div>") +

      /* 播放记录紧跟进度条：用户到放映厅就是为了「接着看」，
         让它出现在进度条旁边比藏在下面更符合意图。
         读当前线路而不是 a.streamEp：多线路并存后，
         不同线路声明的集数可能不同，只有当前线路才是正在看的。 */
      (function(){
        const line = activeSourceOf(a);
        const ep = line && line.ep != null ? line.ep : a.streamEp;
        if(ep == null) return "";
        const when = line && line.savedAt ? line.savedAt : a.streamUrlAt;
        const n = (a.sources || []).length;
        return '<div class="stream-note mt-3">' + ic("play",14) +
          "<span>片源进度：看到第 <b>" + esc(String(ep)) + "</b> 集" +
          (n > 1 ? "（共 " + n + " 条线路，当前「" + esc(line.name || "线路") + "」）" : "") +
          (when ? "（记录于 " + esc(String(when).slice(0,10)) + "）" : "") + "</span></div>";
      })() +

      /* 剧集卡行：TV 影院套系下替代数字输入框。
         放在播放记录正下方 —— 用户从这里出发找的是「第几集」。 */
      episodeRowHTML(a) +

      (a.summary ? '<details class="mt-4"><summary class="sec-title">' + ic("film",16) + "<span>简介</span></summary>" +
        '<div class="summary-box scroll mt-2">' + esc(a.summary) + "</div></details>" : "") +

      ((a.personalTags||[]).length ? '<div class="mt-4"><div class="sec-title">' + ic("grid",16) + "<span>我的标签</span></div>" +
        '<div class="tag-list">' + a.personalTags.map(t => '<span class="chip">' + esc(t) + "</span>").join("") + "</div></div>" : "") +

      (pendingKeys.length ? '<div class="mt-4"><div class="sec-title">' + ic("warning",16) + "<span>待确认字段（导入时发现不同值）</span></div>" +
        '<div class="col">' + pendingKeys.map(k =>
          '<div class="pending-row">' + ic("lock",16) +
          '<span class="small"><b>' + esc(fieldLabel(k)) + "</b>：" + esc(shortVal(a[k])) + " → 新值 " + esc(shortVal(a.pending[k].incomingValue)) + "</span>" +
          '<div class="row" style="margin-left:auto">' +
            '<button class="btn btn-sm" type="button" data-pend="keep" data-k="' + attr(k) + '">保留原值</button>' +
            '<button class="btn btn-sm btn-primary" type="button" data-pend="use" data-k="' + attr(k) + '">采用新值</button>' +
          "</div></div>").join("") + "</div></div>" : "") +

      '<details class="mt-4"><summary class="sec-title">' + ic("refresh",16) + "<span>重看与感想</span>" +
        '<span class="small muted" style="margin-left:auto">' +
          (lastViewingOf(a) ? "上次观看 " + esc(lastViewingOf(a)) + " · " : "") +
          ((a.reviews || []).length ? (a.reviews.length + " 条记录") : "暂无") + "</span></summary>" +
        '<div class="mt-3">' +
        '<button class="btn btn-sm btn-primary" type="button" data-act="rewatch">' + ic("plus",14) + "记录一次观看</button>" +
        (legacyViewingGap(a) ? '<div class="small muted mt-2">更早还有 ' + legacyViewingGap(a) + ' 次观看没有留下日期（升级前的旧记录只计次数）。</div>' : "") +
        (reviews.length
          ? '<div class="review-timeline mt-3">' + reviews.map(r =>
              '<div class="review-item"><div class="review-head"><span class="review-round">第 ' + (r.round||1) + " 次观看</span><span>" + esc(r.date || "") + "</span>" +
              '<span class="review-ops">' +
                '<button class="icon-ghost-btn" type="button" data-act="rv-edit" data-rv="' + attr(r.id || "") + '" aria-label="编辑这条记录" title="编辑">' + ic("edit",13) + "</button>" +
                '<button class="icon-ghost-btn" type="button" data-act="rv-del" data-rv="' + attr(r.id || "") + '" aria-label="删除这条记录" title="删除">' + ic("trash",13) + "</button>" +
              "</span></div>" +
              (r.content ? '<div class="review-body">' + esc(r.content) + "</div>"
                         : '<div class="small muted" style="padding:var(--sp-2) 0">（这次没有写感想，点编辑可以补）</div>') + "</div>").join("") + "</div>"
          : '<div class="small muted mt-3">还没有观看记录。点上面「记录一次观看」，感想可写可不写。</div>') +
        "</div></details>" +

      '<div class="divider"></div>' +
      '<div class="row">' +
        '<button class="btn" type="button" data-act="edit">' + ic("edit",16) + "编辑资料</button>" +
        '<button class="btn btn-danger" type="button" data-act="del">' + ic("trash",16) + "删除作品</button>" +
        '<span class="hint" style="margin-left:auto">最近抓取：' + esc(String(a.fetchedAt || "—").slice(0,10)) + "</span>" +
      "</div>" +
    "</div>" +

    /* 播放器在详情之下 —— 这是本次布局调整的核心。 */
    renderStreamLauncher(a) +
  "</div>";

  root.innerHTML = html;
  bindDetailActions(root, a);
  // 播放器按作品绑定：保存只更新内存与库，不整页重渲染 ——
  // rerender() 会销毁 iframe，正在播的视频会被打断。
  bindStreamLauncher(root, a);
  // 同系列跳转：这些是 <a> 之外的 <button>，走 delegation 而非 data-act
  root.querySelectorAll("[data-series-go]").forEach(b => b.addEventListener("click", () => {
    go("theater", b.dataset.seriesGo);
  }));
  /* 剧集卡选集：只改当前线路的 ep 并落盘，不整页重渲染 ——
     整页重渲染会把正在播的播放器拆掉，而用户点集多半是为了接着看。
     成功后只把卡片的高亮态挪过去（updateEpisodeRowHighlight）。 */
  root.querySelectorAll("[data-ep-pick]").forEach(b => b.addEventListener("click", async () => {
    const ep = Number(b.dataset.epPick);
    if(!(Number.isInteger(ep) && ep > 0)) return;
    const ok = await pickEpisode(root, a, ep);
    if(ok) updateEpisodeRowHighlight(root, a);
  }));
}

/* 重排剧集卡的四态。
   不重渲染整页的理由同上：正在播的视频不能被打断。 */
function updateEpisodeRowHighlight(root, a){
  const cur = currentEpisodeOf(a);
  const watched = Number(a.watchedEpisodes) || 0;
  const total = Number(a.totalEpisodes) || 0;
  root.querySelectorAll("[data-ep-pick]").forEach(b => {
    const i = Number(b.dataset.epPick);
    b.classList.toggle("is-watched", i <= watched && i !== cur);
    b.classList.toggle("is-playing", i === cur);
    b.classList.toggle("is-next", i !== cur && i === cur + 1 && cur + 1 <= total);
    const bar = b.querySelector(".tv-ep-prog > i");
    if(bar) bar.style.width = (i <= watched && i !== cur) ? "100%" : (i === cur ? "50%" : "0%");
    b.setAttribute("aria-label", "第 " + i + " 集" +
      (i === cur ? "（正在看）" : i <= watched ? "（已看）" : i === cur + 1 && cur + 1 <= total ? "（下一集）" : "（未看）"));
  });
  const head = root.querySelector("[data-ep-current]");
  if(head) head.textContent = cur ? "当前第 " + cur + " 集" : "未开始";
}

/* 详情页的系列区块。
   默认系列下作品可能极多，全部列出反而变成一堵墙 ——
   那种情况下只提示可以归类，不铺列表。 */
/* ---- 剧集卡行（详情页，TV 影院套系）----
   形态照 Izuko_TV 的 FocusEpisodesSection：16:9 剧照 + 集号 + 3px 进度条，
   看过压暗、在播描边。

   但有一条必须说清的差别：本项目没有逐集剧照与集名数据。
   抓取侧只存作品级封面（coverUrl）与总集数，没有 per-episode 的 still / title。
   所以这里的剧照位退化为「作品封面 + 集号」，集名退化为「第 N 集」。
   把它渲染成好像有剧照的样子（随机图、编号代替图）只会误导用户 ——
   看着像有，实际点进去什么都没有。

   想补真数据要动抓取侧（Animeko 那边是 EpisodeInfo.still / name，
   B 站接口确实给得到），那是另一次改动，不该在这一层假装已经做了。 */
function episodeRowHTML(a){
  if(settings.ui_skin !== "tv") return "";
  const total = Number(a.totalEpisodes) || 0;
  if(!(total > 0)) return "";
  const shown = Math.min(total, TV_ROW.epRowLimit);
  const cur = currentEpisodeOf(a);
  const watched = Number(a.watchedEpisodes) || 0;

  const cards = [];
  for(let i = 1; i <= shown; i++){
    /* 四态：已看（压暗）/ 在播（描边）/ 下一集（虚线描边）/ 未看（常态）。
       is-next 只在「在播的那一集之后还有没看过的」时才点亮 ——
       已经看到最后一集时再标「下一集」是骗人的。 */
    const isWatched = i <= watched && i !== cur;
    const isPlaying = i === cur;
    const isNext = !isPlaying && i === cur + 1 && cur + 1 <= total;
    /* 单集进度条没有真实数据（我们只记了「看到第几集」），
       所以条只表示三种态：看完 = 满格、在播 = 50%、其余 = 空。
       写一个假的百分比进去比空条更糟：用户会以为那一集看过 37%。 */
    const fill = isWatched ? 100 : (isPlaying ? 50 : 0);
    const cls = "tv-ep" + (isWatched ? " is-watched" : "") + (isPlaying ? " is-playing" : "") + (isNext ? " is-next" : "");
    const label = "第 " + i + " 集" + (isWatched ? "（已看）" : isPlaying ? "（正在看）" : isNext ? "（下一集）" : "（未看）");
    cards.push(
      '<button type="button" class="' + cls + '" data-ep-pick="' + i + '" aria-label="' + attr(label) + '">' +
        '<div class="tv-ep-still"' + (coverSrcOf(a) ? ' style="background-image:url(' + attr(coverSrcOf(a)) + ')"' : "") + ">" +
          '<span class="tv-ep-no">EP ' + String(i).padStart(2, "0") + "</span>" +
        "</div>" +
        '<div class="tv-ep-body">' +
          '<div class="tv-ep-name">' + esc(a.titleCn || a.titleOriginal || "未命名") + "</div>" +
          '<div class="tv-ep-prog"><i style="width:' + fill + '%"></i></div>' +
        "</div>" +
      "</button>");
  }

  const truncNote = total > shown
    ? '<span class="hint">共 ' + total + " 集，已显示前 " + shown + " 集（上限 " + TV_ROW.epRowLimit + "，可在下方填准确集数）</span>"
    : '<span class="hint">' + total + " 集 · 点一集即把它设为当前集</span>";

  return '<div class="mt-4">' +
    '<div class="sec-title">' + ic("film",16) + "<span>剧集</span>" +
      '<span class="small muted" style="margin-left:auto" data-ep-current>' + (cur ? "当前第 " + cur + " 集" : "未开始") + "</span></div>" +
    '<div class="tv-ep-row">' + cards.join("") + "</div>" +
    '<div class="mt-2">' + truncNote + "</div>" +
  "</div>";
}

/* 点剧集卡 = 把它设为当前集。
   与播放器面板的「看到第几集」输入框写同一个字段，
   两处独立赋值会出现「卡上说是第 5 集、面板里还是第 3 集」。 */
async function pickEpisode(root, a, ep){
  migrateSources(a);
  const line = activeSourceOf(a);
  if(!line){
    toast("先添加一条播放源，再选集", "warn");
    return false;
  }
  line.ep = ep;
  line.savedAt = new Date().toISOString();
  a.activeSourceId = line.id;
  a.streamEp = ep;
  a.streamUrlAt = line.savedAt;
  await saveAnime(a);
  /* 把面板一起改掉：#st-ep 与状态条的值都是渲染那一刻的快照，
     不同步的话同一页上「卡上第 7 集、面板第 2 集」自相矛盾，
     用户会以为点集没生效。 */
  const input = root.querySelector("#st-ep");
  if(input) input.value = String(ep);
  const status = root.querySelector("#st-status");
  if(status && status.classList.contains("is-ok")){
    const when = line.savedAt ? String(line.savedAt).slice(0,10) : "";
    status.innerHTML = ic("check",16) + "<span>当前线路：" + esc(line.name || "线路") +
      " · 第 " + esc(String(ep)) + " 集" + (when ? "（记录于 " + esc(when) + "）" : "") + "</span>";
  }
  return true;
}

function seriesBlockHTML(a){
  const s = seriesById(a.seriesId);
  const siblings = state.anime
    .filter(x => x.id !== a.id && (x.seriesId || DEFAULT_SERIES_ID) === (a.seriesId || DEFAULT_SERIES_ID))
    .sort((x,y) => String(x.airDate||"9999").localeCompare(String(y.airDate||"9999")));

  const picker =
    '<div class="row gap-2 mt-3" style="flex-wrap:wrap">' +
      '<label class="small muted nowrap" for="dt-series">归入系列</label>' +
      '<select class="select" id="dt-series" style="flex:1 1 200px">' + seriesOptionsHTML(a.seriesId) + "</select>" +
      '<input class="input" id="dt-seriesNew" placeholder="新系列名称" maxlength="30" style="flex:1 1 150px" ' +
        'aria-label="新建系列名称，留空则不创建">' +
      '<button class="btn btn-sm" type="button" id="dt-seriesAdd">' + ic("plus",14) + "新建</button>" +
    "</div>";

  if(!s && siblings.length < 2){
    return '<div class="mt-4"><div class="sec-title">' + ic("grid",16) + "<span>系列</span></div>" +
      '<div class="small muted">尚未归类。一部动画常有多季 / 剧场版，归到同一系列后可以互相跳转。</div>' +
      picker + "</div>";
  }

  const list = siblings.length
    ? '<div class="series-sibs mt-3">' + siblings.map(x => {
        const nm = x.titleCn || x.titleOriginal || "未命名";
        const prog = progressOf(x);
        return '<button class="sib-card" type="button" data-series-go="' + attr(x.id) + '">' +
          '<div class="sib-thumb">' + coverThumb(x) + "</div>" +
          '<div class="sib-body"><div class="sib-name clamp-2">' + esc(nm) + "</div>" +
            '<div class="sib-meta">' + ic("clock",11) + " " +
              (x.watchedEpisodes||0) + "/" + (x.totalEpisodes == null ? "?" : x.totalEpisodes) +
              (prog == null ? "" : " · " + Math.round(prog) + "%") +
              ' · <span class="st-dot" style="--st-color:' + esc(statusColor(x)) + '"><i></i></span> ' +
              esc(statusName(x)) +
          "</div></div></button>";
      }).join("") + "</div>"
    : '<div class="small muted mt-3">这个系列目前只有这一部作品。</div>';

  return '<div class="mt-4"><div class="sec-title">' + ic("grid",16) +
      "<span>" + esc(s ? s.name : "默认系列") + "</span>" +
      '<b class="small muted" style="margin-left:auto">' + (siblings.length + 1) + " 部</b></div>" +
    list + picker + "</div>";
}
function sourceLabel(a){
  if(a.source === "bangumi") return "Bangumi";
  if(a.source === "anilist") return "AniList";
  return "手动录入";
}
function fieldLabel(k){
  return ({ titleCn:"中文名", titleOriginal:"原名", aliases:"别名", coverUrl:"封面", airDate:"首播日期",
    totalEpisodes:"总集数", genres:"类型", studios:"制作公司", summary:"简介", communityScore:"社区评分", durationMinutes:"片长" })[k] || k;
}
function shortVal(v){
  const s = Array.isArray(v) ? v.join("、") : String(v == null ? "" : v);
  return s.length > 40 ? s.slice(0, 40) + "…" : (s || "（空）");
}
function bindDetailActions(root, a){
  root.querySelectorAll("[data-act]").forEach(b => b.addEventListener("click", async () => {
    const act = b.dataset.act;
    if(act === "back"){ go("theater"); return; }
    if(act === "fav"){ a.favorite = !a.favorite; await saveAnime(a); rerender(); return; }
    if(act === "master"){ a.masterpiece = !a.masterpiece; await saveAnime(a); rerender(); return; }
    if(act === "rewatch"){ await promptReview(a); return; }
    if(act === "rv-edit" || act === "rv-del"){
      const rv = (a.reviews || []).find(x => x.id === b.dataset.rv);
      if(!rv){ rerender(); return; }
      if(act === "rv-edit"){ await promptReview(a, { review:rv }); return; }
      const ok = await confirmDialog({
        title:"删除这条感想",
        html:"确定删除「第 " + (rv.round||1) + " 次观看 · " + esc(String(rv.date||"").slice(0,10)) + "」这条感想吗？<br><span class=\"hint\">只删这条记录，不影响重看次数与作品本身；删除后无法恢复。</span>",
        okText:"删除", danger:true
      });
      if(ok){
        a.reviews = (a.reviews || []).filter(x => x.id !== rv.id);
        await saveAnime(a);
        toast("已删除这条感想", "ok");
        rerender();
      }
      return;
    }
    if(act === "edit"){ openAnimeForm({ anime:a }); return; }
    if(act === "del"){
      const ok = await confirmDialog({
        title:"删除作品",
        html:"确定删除《" + esc(a.titleCn) + "》吗？<br>该作品的 " + (a.reviews||[]).length + " 条感想会一并删除，无法恢复。<br><span class=\"hint\">建议先到「设置 → 数据」导出备份。</span>",
        okText:"删除", danger:true
      });
      if(ok){ await removeAnime(a.id); toast("已删除","ok"); go("theater"); }
    }
  }));
  root.querySelectorAll("[data-pend]").forEach(b => b.addEventListener("click", async () => {
    const k = b.dataset.k;
    if(b.dataset.pend === "use"){
      a[k] = a.pending[k].incomingValue;
      a.locked = a.locked || {};
      a.locked[k] = true;
    }
    delete a.pending[k];
    await saveAnime(a);
    rerender();
  }));

  /* 系列下拉：改完立即落库。走 rerender() 整页重渲是安全的 ——
     这一段位于播放器之上，而播放器的 iframe 靠 bindStreamLauncher
     在渲染后重新挂载。 */
  const dsel = root.querySelector("#dt-series");
  if(dsel) dsel.addEventListener("change", async () => {
    a.seriesId = seriesById(dsel.value) ? dsel.value : DEFAULT_SERIES_ID;
    await saveAnime(a);
    toast("已归入「" + seriesNameOf(a) + "」", "ok");
    rerender();
  });
  /* 详情页的「新建系列」：与添加/编辑表单同一套语义 ——
     已存在则直接选中（不报错、不重复建），否则真建一条并选中。 */
  const realAdd = root.querySelector("#dt-seriesAdd");
  const realIn  = root.querySelector("#dt-seriesNew");
  if(dsel && realAdd && realIn){
    realAdd.addEventListener("click", async () => {
      const name = realIn.value.trim();
      if(!name){ toast("请先填写新系列名称", "warn"); realIn.focus(); return; }
      const dup = state.series.find(s => normalize(s.name) === normalize(name));
      if(dup){
        dsel.value = dup.id;
        realIn.value = "";
        toast("「" + dup.name + "」已存在，已直接选中", "warn");
      } else {
        realAdd.disabled = true;
        const prev = realAdd.innerHTML;
        realAdd.innerHTML = '<span class="spinner"></span>';
        const rec = await ensureSeries(name);
        realAdd.disabled = false;
        realAdd.innerHTML = prev;
        if(!rec){ toast("新建系列失败，请重试", "err"); return; }
        dsel.innerHTML = seriesOptionsHTML(rec.id);
        realIn.value = "";
        toast("已创建系列「" + rec.name + "」", "ok");
      }
      dsel.dispatchEvent(new Event("change"));
    });
    realIn.addEventListener("keydown", e => {
      if(e.key === "Enter"){ e.preventDefault(); realAdd.click(); }
    });
  }
}

registerPage({
  id:"theater", name:"放映厅", icon:"theater", title:"放映厅",
  sub:"选中一部作品：详情在上、播放器在下，片源与进度按作品保存",
  actions(box){
    /* 原先这里是 CRT/现代影院皮肤切换 + 「换一条语录」。
       两组控件都服务于语录待机屏保 —— 皮肤切换换的是待机大屏的样式，
       「换一条语录」换的是待机时轮播的台词。待机屏保按用户要求删除后，
       它们失去了唯一的作用对象，留着就是两个点不动的按钮。
       开机音效（crt_power_sound）是另一条独立路径，不依赖这里，保留。 */
    const n = state.anime.length;
    box.innerHTML = '<span class="hint">' +
      (n ? "共 " + n + " 部作品 · 点片名进入放映" : "片库为空，先去添加一部") + "</span>" +
      (n ? '<button class="btn btn-sm" type="button" data-act="pick">' + ic("library",14) + "换一部</button>" : "");
    const b = box.querySelector('[data-act="pick"]');
    if(b) b.addEventListener("click", () => go("theater"));
  },
  render(root){
    if(state.routeId) renderDetail(root, state.routeId);
    else renderStandby(root);
  }
});

