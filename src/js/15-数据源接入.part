/* ============================================================
   8. 数据源接入（Bangumi → AniList → 手动）
   ============================================================ */
const API_TIMEOUT = 8000;

function fetchWithTimeout(url, opts, ms){
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), ms || API_TIMEOUT);
  return fetch(url, Object.assign({}, opts, { signal: ctrl.signal }))
    .finally(() => clearTimeout(t));
}
function proxyUrl(target){
  const p = (settings.data_proxy_url || "").trim();
  if(!p) return null;
  return p + encodeURIComponent(target);
}
/* 公共代理有一类会把响应包一层壳再返回：
   allorigins 的 /get 就是 { contents: "<原 body 字符串>" }，
   corsproxy.xyz 的非raw 端点也是类似结构。
   不解包的话 res.json() 拿到的是壳对象，下游读 data.data 全是undefined，
   表现成「搜索到 0 条结果」—— 而用户会以为是自己的关键词没匹配上。

   判据要严：只有壳里确实是字符串、且能解析成对象、且不是错误页，
   才认它是壳。只认 contents 一个键是不够的：目标自己返回一个
   带 contents 字段的合法 JSON 时会被误拆。 */
function unwrapProxyPayload(data){
  if(!data || typeof data !== "object" || Array.isArray(data)) return data;
  if(typeof data.contents !== "string") return data;
  let inner;
  try{ inner = JSON.parse(data.contents); }
  catch(e){ return data; }               /* 壳里不是 JSON：不是壳，按原样 */
  if(!inner || typeof inner !== "object") return data;
  /* 代理出错时 contents 常是 HTML 错误页或 { error: ... }。
     那种情况下原样返回，让下游按错误处理 —— 把错误页解析成
     「空结果」会把代理故障伪装成「没搜到」，是最难查的一类假象。 */
  if(inner.error || inner.status || typeof inner.html === "string") return data;
  return inner;
}

/* 代理自检：填完地址先点这个，别直接拿去搜索。
   分四层报，因为用户看到「搜索失败」时无法区分是哪一层坏了：
     ① 代理地址本身能不能解析出 host（填错格式最常见）
     ② 网络能不能到（超时 = 大概率被墙/被限流）
     ③ 有没有HTTP 响应
     ④ 有没有 CORS 头 —— 这一层最隐蔽：curl 看着完全正常，
        页面上照样失败，因为浏览器不让读没有 ACAO 的响应。
   附带说明该代理是否需要 API Key。 */
async function diagnoseProxy(prefix){
  const report = { prefix: prefix, ok: false, stage: "", detail: "", cors: null, status: null };
  let u = null;
  try{ u = new URL(prefix); }
  catch(e){
    report.stage = "地址格式";
    report.detail = "不是合法 URL（要含 https:// 与 ?url= 之类的参数）";
    return report;
  }
  /* 探测目标用 AniList 根路径：GET 必然返回 400/404，
     「有响应」就说明代理把请求转发出去了。不拿它当成功判据 ——
     能转发和能用是两件事。 */
  const probe = "https://graphql.anilist.co";
  let res = null, err = null;
  try{
    res = await fetchWithTimeout(prefix + encodeURIComponent(probe), {
      method: "GET", headers: { "Accept": "application/json" }
    }, 9000);
  }catch(e){ err = e; }
  if(err){
    const name = (err && err.name) || "";
    if(name === "AbortError"){
      report.stage = "网络";
      report.detail = "9秒 无响应。公共免费代理多数在境外，国内常常连不上或被限流";
    }else{
      report.stage = "网络";
      report.detail = "请求失败：" + ((err && err.message) || name || "未知");
    }
    return report;
  }
  report.status = res.status;
  report.cors = !!res.headers.get("access-control-allow-origin");
  if(res.status === 401 || res.status === 403){
    report.stage = "需要授权";
    report.detail = "HTTP " + res.status + "：该代理需要 API Key 或已关闭免费额度";
    return report;
  }
  if(res.status === 429){
    report.stage = "被限流";
    report.detail = "HTTP 429：请求过于频繁，稍后再试";
    return report;
  }
  if(!report.cors){
    report.stage = "CORS 头";
    report.detail = "HTTP " + res.status + " 但响应没有 Access-Control-Allow-Origin，浏览器仍会拦截";
    return report;
  }
  if(res.status >= 400 && res.status < 500){
    /* 4xx + 有 CORS 头 = 转发成功了，目标自己不接受这个方法。
       对自检来说这就是通过。 */
    report.ok = true;
    report.stage = "可用";
    report.detail = "转发正常（探测目标返回 " + res.status + " 属预期：它不接受 GET）";
    return report;
  }
  if(res.status >= 500){
    report.stage = "代理侧错误";
    report.detail = "HTTP " + res.status + "：代理自己出错了";
    return report;
  }
  report.ok = true;
  report.stage = "可用";
  report.detail = "HTTP " + res.status;
  return report;
}

async function fetchJSON(target, opts, useProxy){
  const tryOnce = async (url) => {
    const res = await fetchWithTimeout(url, opts);
    if(!res.ok) {
      const e = new Error("HTTP " + res.status);
      e.httpStatus = res.status;
      throw e;
    }
    return unwrapProxyPayload(await res.json());
  };
  try{
    return await tryOnce(target);
  }catch(err){
    if(!useProxy){ throw err; }
    const p = proxyUrl(target);
    if(!p) throw err;
    const e2 = new Error("代理请求也失败了");
    try{ return await tryOnce(p); }
    catch(err2){
      if(err2 && err2.httpStatus){ e2.message = "HTTP " + err2.httpStatus; }
      else if(err2 && /JSON|Unexpected/i.test(err2.message || "")){
        /* 代理返回了非 JSON：多半是它自己出错了而不是目标出错。
           照实说「代理返回的不是 JSON」，别让用户去查关键词。 */
        e2.message = "代理返回的内容不是 JSON（该地址可能不是 CORS 代理，或已失效）";
      }
      throw e2;
    }
  }
}

/* 8.1 Bangumi */
function bangumiBody(keyword){
  return JSON.stringify({ keyword: keyword, filter: { type: [2] } });
}
async function searchBangumi(keyword){
  const target = "https://api.bgm.tv/v0/search/subjects?limit=" + clampNum(settings.search_limit,1,25);
  const opts = { method:"POST", headers:{ "Content-Type":"application/json", "Accept":"application/json" }, body: bangumiBody(keyword) };
  const data = await fetchJSON(target, opts, true);
  const list = Array.isArray(data && data.data) ? data.data : [];
  return list.map(s => ({
    id: s.id,
    sourceId: String(s.id),
    sourceLabel: "Bangumi",
    source: "bangumi",
    titleCn: (s.name_cn || "").trim() || (s.name || "").trim(),
    titleOriginal: (s.name || "").trim(),
    coverUrl: (s.images && (s.images.large || s.images.common || s.images.medium)) || "",
    airDate: s.date || "",
    totalEpisodes: (s.eps == null ? null : s.eps),
    communityScore: (s.score ? Math.round(s.score * 10) / 10 : null),
    summary: s.summary || ""
  }));
}
async function detailBangumi(sid){
  const target = "https://api.bgm.tv/v0/subjects/" + sid;
  const data = await fetchJSON(target, { method:"GET", headers:{ "Accept":"application/json" } }, true);
  const summary = cleanText(data.summary || "");
  return {
    sourceId: String(data.id),
    sourceLabel: "Bangumi",
    source: "bangumi",
    titleCn: (data.name_cn || "").trim() || (data.name || "").trim(),
    titleOriginal: (data.name || "").trim(),
    coverUrl: (data.images && (data.images.large || data.images.common || data.images.medium)) || "",
    airDate: data.date || "",
    totalEpisodes: (data.eps == null ? null : data.eps),
    genres: (Array.isArray(data.tags) ? data.tags.map(t => t && t.name).filter(Boolean) : []).slice(0, 16),
    studios: parseBangumiInfobox(data.infobox),
    summary: summary,
    communityScore: (data.rating && data.rating.score ? Math.round(data.rating.score * 10) / 10 : null)
  };
}
const STUDIO_KEYS = ["动画制作","制作公司","制作会社","制作","プロデュース","アニメーション制作","出品","animation studio"];
function parseBangumiInfobox(infobox){
  const out = [];
  if(!Array.isArray(infobox)) return out;
  infobox.forEach(item => {
    const key = String((item && item.key) || "");
    if(!STUDIO_KEYS.some(k => key.indexOf(k) >= 0 && ["动画制作","制作公司","制作会社","プロデュース","アニメーション制作"].indexOf(k) >= 0)) return;
    let val = item.value;
    const push = v => { const s = cleanText(v); if(s && out.indexOf(s) < 0) out.push(s); };
    if(Array.isArray(val)) val.forEach(v => push(typeof v === "string" ? v : (v && (v.name || v.v || v.value) || "")));
    else if(val && typeof val === "object") push(val.name || val.v || val.value || "");
    else if(typeof val === "string") val.split(/[、,，\/]/).forEach(push);
  });
  return out;
}
function cleanText(html){
  let s = String(html || "");
  s = s.replace(/<br\s*\/?>/gi, "\n");
  s = s.replace(/\[\/?mask\]/gi, "");
  s = s.replace(/<[^>]+>/g, "");
  /* &amp; 必须最后解码：先解它会把源文本里的字面量 &amp;lt; 二次解码成 < */
  s = s.replace(/&nbsp;/g, " ").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, "&");
  s = s.replace(/[ \t]+\n/g, "\n").replace(/\n{3,}/g, "\n\n");
  return s.trim();
}

/* 8.2 AniList GraphQL */
const ANILIST_QUERY = `
query ($q: String, $perPage: Int) {
  Page(perPage: $perPage) {
    pageInfo { total }
    media(search: $q, type: ANIME, sort: SEARCH_MATCH) {
      id
      title { romaji english native }
      coverImage { extraLarge large }
      episodes
      duration
      startDate { year month day }
      studios(isMain: true) { nodes { name } }
      genres
      description(asHtml: false)
      averageScore
      synonyms
    }
  }
}`;
async function searchAniList(keyword){
  const body = JSON.stringify({ query: ANILIST_QUERY, variables: { q: keyword, perPage: clampNum(settings.search_limit,1,25) } });
  const opts = { method:"POST", headers:{ "Content-Type":"application/json", "Accept":"application/json" }, body: body };
  const data = await fetchJSON("https://graphql.anilist.co", opts, true);
  const media = (data && data.data && data.data.Page && data.data.Page.media) || [];
  return media.map(m => ({
    id: m.id,
    sourceId: String(m.id),
    sourceLabel: "AniList",
    source: "anilist",
    titleCn: (m.title && ((m.title.english || m.title.romaji) || "")) || (m.title && m.title.native) || "",
    titleOriginal: (m.title && m.title.native) || "",
    noCnName: !(m.title && m.title.english),
    coverUrl: (m.coverImage && (m.coverImage.extraLarge || m.coverImage.large)) || "",
    airDate: joinASD(m.startDate),
    totalEpisodes: (m.episodes == null ? null : m.episodes),
    genres: Array.isArray(m.genres) ? m.genres.slice(0,12) : [],
    studios: ((m.studios && m.studios.nodes) || []).map(n => n && n.name).filter(Boolean).slice(0,4),
    summary: cleanText(m.description || ""),
    communityScore: (m.averageScore ? Math.round(m.averageScore / 10 * 10) / 10 : null),
    durationMinutes: (m.duration == null ? null : m.duration),
    synonyms: Array.isArray(m.synonyms) ? m.synonyms.slice(0,6) : []
  }));
}
function joinASD(d){
  if(!d || !d.year) return "";
  const p = n => String(n).padStart(2,"0");
  return d.year + (d.month ? "-" + p(d.month) : "") + (d.day ? "-" + p(d.day) : "");
}

/* 组合搜索：Bangumi → AniList */
async function searchAll(keyword, onPartial){
  const out = { results: [], notices: [], errors: [], sources: [] };
  const tasks = [];
  if(settings.src_bangumi_enabled){
    tasks.push(searchBangumi(keyword).then(list => {
      out.results = out.results.concat(list);
      out.sources.push({ name:"Bangumi", count: list.length, ok:true });
      if(onPartial) onPartial(out);
    }).catch(e => {
      out.errors.push({ name:"Bangumi", message: describeFetchError(e) });
      out.sources.push({ name:"Bangumi", count:0, ok:false });
      if(onPartial) onPartial(out);
    }));
  }
  if(settings.src_anilist_enabled){
    tasks.push(searchAniList(keyword).then(list => {
      out.results = out.results.concat(list);
      out.sources.push({ name:"AniList", count: list.length, ok:true });
      if(onPartial) onPartial(out);
    }).catch(e => {
      out.errors.push({ name:"AniList", message: describeFetchError(e) });
      out.sources.push({ name:"AniList", count:0, ok:false });
      if(onPartial) onPartial(out);
    }));
  }
  customSources().filter(cs => cs.enabled).forEach(cs => {
    tasks.push(searchCustomSource(cs, keyword).then(list => {
      out.results = out.results.concat(list);
      out.sources.push({ name: cs.name, count: list.length, ok:true });
      if(onPartial) onPartial(out);
    }).catch(e => {
      out.errors.push({ name: cs.name, message: describeFetchError(e) });
      out.sources.push({ name: cs.name, count:0, ok:false });
      if(onPartial) onPartial(out);
    }));
  });
  if(!tasks.length){
    out.errors.push({ name:"数据源", message:"所有数据源都已在设置中被关闭" });
    return out;
  }
  await Promise.allSettled(tasks);
  if(out.results.length && out.sources.some(s => s.name === "AniList" && s.ok) && out.sources.some(s => s.name === "Bangumi" && !s.ok)){
    out.notices.push("以下结果来自 AniList");
  }
  if(out.sources.some(s => s.name === "AniList" && s.ok) && out.sources.some(s => s.name === "Bangumi" && s.ok)){
    out.notices.push("Bangumi 与 AniList 结果已合并");
  }
  return out;
}
function describeFetchError(e){
  if(e && e.name === "AbortError") return "请求超时（8 秒）";
  if(e && /代理/.test(e.message)) return e.message + "，请检查设置中的代理地址";
  const msg = (e && e.message) || String(e);
  if(/Failed to fetch|NetworkError|TypeError/i.test(msg)) return "网络错误或被浏览器跨域拦截（可在设置中配置代理）";
  return msg;
}
/* 8.3 候选 → 详情补全 */
async function enrichCandidate(c){
  const full = Object.assign({}, c);
  try{
    if(c.source === "bangumi"){
      const d = await detailBangumi(c.sourceId);
      Object.assign(full, d, { sourceIds: { bangumi: String(c.sourceId) } });
    } else if(c.source === "anilist"){
      // AniList 搜索结果已是完整字段，仅补充别名
      full.sourceIds = { anilist: String(c.sourceId) };
      full.aliases = (c.synonyms || []).slice(0,6);
    } else {
      const cs = customSources().find(x => x.id === c.source);
      if(cs) return await enrichCustomCandidate(c, cs);
      // 未知来源（旧备份等）：保守地带上原始 id，不做网络请求
      full.sourceIds = {};
      if(c.sourceId != null) full.sourceIds[c.source] = String(c.sourceId);
    }
  }catch(e){
    full._warn = "详情抓取失败，已用搜索结果的基础字段：" + describeFetchError(e);
    full.sourceIds = {};
    full.sourceIds[c.source] = String(c.sourceId);
  }
  delete full.id;
  delete full.synonyms;
  return full;
}


/* ============================================================
   8.4 自定义抓取数据源（设置 → 数据源 增删改）
   ------------------------------------------------------------
   需求原话：内置源国内访问不稳，「也可以用百度这些靠抓取信息填写」。
   每个自定义源 = 搜索网址模板 + 取值规则：
     · html 模式：DOMParser 解析结果页，itemSelector 圈出每条结果，
       fields 里的选择器取字段 —— .t 取文本，img@src 取属性；
     · json 模式：listPath 点路径指到数组，jfields 点路径取字段
       （少数站点/代理直接给 JSON 时用）；
   点搜索结果时可选再抓详情页补全（detailSelectors）。
   目标站不允许跨域时走 fetchSourceText：直连失败自动落到
   设置里配的 CORS 代理（与内置源同一代理链路）。
   ============================================================ */
function customSources(){ return Array.isArray(settings.custom_sources) ? settings.custom_sources : []; }
function saveCustomSources(list){ settings.custom_sources = list; saveSettings(); }
/* 归一化：截断、补默认值、保 id 稳定。表单保存与导入共用。 */
function normalizeCustomSource(src){
  const s = src || {};
  const pickStr = v => String(v == null ? "" : v).trim().slice(0, 160);
  const fields = {
    title: pickStr(s.fields && s.fields.title),
    link:  pickStr(s.fields && s.fields.link),
    cover: pickStr(s.fields && s.fields.cover),
    meta:  pickStr(s.fields && s.fields.meta)
  };
  const jfields = {
    title: pickStr(s.jfields && s.jfields.title),
    link:  pickStr(s.jfields && s.jfields.link),
    cover: pickStr(s.jfields && s.jfields.cover),
    meta:  pickStr(s.jfields && s.jfields.meta),
    genres: pickStr(s.jfields && s.jfields.genres)
  };
  const ds = s.detailSelectors || {};
  const detailSelectors = {};
  ["titleCn","titleOriginal","cover","airDate","totalEpisodes","summary","genres","studios","communityScore"].forEach(k => { detailSelectors[k] = pickStr(ds[k]); });
  return {
    id: (typeof s.id === "string" && /^cs_[\w-]+$/.test(s.id)) ? s.id : uid("cs"),
    name: String(s.name || "").trim().slice(0, 20),
    enabled: s.enabled !== false,
    searchUrl: pickStr(s.searchUrl),
    mode: s.mode === "json" ? "json" : "html",
    itemSelector: pickStr(s.itemSelector),
    fields,
    listPath: pickStr(s.listPath),
    jfields,
    detailEnabled: s.detailEnabled !== false,
    detailSelectors
  };
}
function customSourceValidate(cs){
  if(!cs.name) return "名称必填";
  if(!/^https?:\/\//i.test(cs.searchUrl.replace(/\{kw\}/g, "X"))) return "搜索网址必须以 http/https 开头";
  if(cs.mode === "html"){
    if(!cs.itemSelector) return "HTML 模式需要「结果条目选择器」";
    if(!cs.fields.title || !cs.fields.link) return "HTML 模式需要「标题」与「链接」选择器";
  }else{
    if(!cs.listPath) return "JSON 模式需要「列表路径」";
    if(!cs.jfields.title) return "JSON 模式需要「标题」字段路径";
  }
  return "";
}
/* 取值规则：选择器取文本；选择器@属性 取属性。
   multi = 取所有匹配（类型/公司这类多值字段）。 */
function extractBySpec(root, spec, multi){
  const s = String(spec || "").trim();
  if(!s || !root) return multi ? [] : "";
  const m = /^([^@]+?)(?:@([\w-]+))?$/.exec(s);
  if(!m) return multi ? [] : "";
  const sel = m[1].trim(), attr = m[2];
  if(multi){
    return Array.from(root.querySelectorAll(sel))
      .map(el => (attr ? (el.getAttribute(attr) || "") : (el.textContent || "")))
      .map(x => x.trim()).filter(Boolean);
  }
  const el = root.querySelector(sel);
  if(!el) return "";
  return attr ? (el.getAttribute(attr) || "") : (el.textContent || "").trim();
}
function resolvePath(obj, path){
  let cur = obj;
  String(path || "").split(".").filter(Boolean).forEach(p => { if(cur != null) cur = cur[p]; });
  return cur;
}
function jsonGet(obj, path){
  const v = resolvePath(obj, path);
  if(v == null) return "";
  return typeof v === "object" ? JSON.stringify(v) : String(v);
}
/* 抓页面文本：直连 → 失败落到 CORS 代理（若配置）。
   代理壳（{ contents: 原文 }）在此拆开 —— 文本场景没有 unwrapProxyPayload
   能复用的 JSON 判据，用「能 parse 成对象且带 contents 字符串」的窄判据。 */
async function fetchSourceText(url){
  const tryOnce = async u => {
    const res = await fetchWithTimeout(u, { headers: { "Accept": "text/html,application/json;q=0.9,*/*;q=0.8" } });
    if(!res.ok){ const e = new Error("HTTP " + res.status); e.httpStatus = res.status; throw e; }
    return await res.text();
  };
  try{
    return await tryOnce(url);
  }catch(err){
    const p = proxyUrl(url);
    if(!p) throw err;
    const e2 = new Error("代理请求也失败了");
    try{
      let text = await tryOnce(p);
      if(text && text.charAt(0) === "{"){
        try{
          const j = JSON.parse(text);
          if(j && typeof j.contents === "string") text = j.contents;
        }catch(e3){}
      }
      return text;
    }catch(err2){
      if(err2 && err2.httpStatus) e2.message = "HTTP " + err2.httpStatus;
      else if(err2 && /Failed to fetch|NetworkError/i.test(err2.message || "")) e2.message = "代理连不上（可在设置里测试代理）";
      throw e2;
    }
  }
}
function customCandidateFrom(cs, getValue, baseUrl){
  const title = String(getValue(cs.mode === "json" ? cs.jfields.title : cs.fields.title) || "").trim();
  let link = String(getValue(cs.mode === "json" ? cs.jfields.link : cs.fields.link) || "").trim();
  if(!title) return null;
  if(link && !/^https?:\/\//i.test(link) && baseUrl){
    try{ link = new URL(link, baseUrl).href; }catch(e){ link = ""; }
  }
  const cover = String(getValue(cs.mode === "json" ? cs.jfields.cover : cs.fields.cover) || "").trim();
  let coverUrl = cover;
  if(coverUrl && !/^data:/i.test(coverUrl) && baseUrl){
    try{ coverUrl = new URL(coverUrl, baseUrl).href; }catch(e){}
  }
  const meta = String(getValue(cs.mode === "json" ? cs.jfields.meta : cs.fields.meta) || "").trim();
  const ym = meta.match(/(19\d{2}|20\d{2})/);
  return {
    id: link || title,
    sourceId: link || title,
    sourceLabel: cs.name,
    source: cs.id,
    titleCn: title,
    titleOriginal: "",
    coverUrl: coverUrl,
    airDate: ym ? ym[1] : "",
    totalEpisodes: null,
    summary: "",
    genres: [],
    studios: []
  };
}
async function searchCustomSource(cs, keyword){
  const url = buildSearchUrl(cs.searchUrl, keyword);
  if(!url) throw new Error("搜索网址模板无效");
  const text = await fetchSourceText(url);
  let items;
  if(cs.mode === "json"){
    let data;
    try{ data = JSON.parse(text); }
    catch(e){ throw new Error("返回内容不是 JSON（该地址可能是网页而非接口，或代理返回了错误页）"); }
    data = unwrapProxyPayload(data);
    const arr = resolvePath(data, cs.listPath);
    if(!Array.isArray(arr)) throw new Error("列表路径「" + cs.listPath + "」没有指到数组");
    items = arr.map(it => ({ json:true, it, el:null }));
  }else{
    const doc = new DOMParser().parseFromString(text, "text/html");
    const els = Array.from(doc.querySelectorAll(cs.itemSelector));
    if(!els.length) throw new Error("条目选择器「" + cs.itemSelector + "」没有匹配到任何元素");
    items = els.map(el => ({ json:false, it:null, el }));
  }
  const out = [], seen = new Set();
  for(const item of items){
    const getValue = spec => item.json ? jsonGet(item.it, spec) : extractBySpec(item.el, spec, false);
    const c = customCandidateFrom(cs, getValue, url);
    if(!c) continue;
    const key = c.sourceId;
    if(seen.has(key)) continue;
    seen.add(key);
    out.push(c);
    if(out.length >= clampNum(settings.search_limit,1,25)) break;
  }
  if(!out.length) throw new Error("解析到 0 条结果（选择器可能没对上字段）");
  return out;
}
/* 详情页补全：点搜索结果后，按 detailSelectors 再抓一页把字段填齐。
   只覆盖抓到的非空字段，搜索结果里已有的信息不会被空值清掉。 */
async function enrichCustomCandidate(c, cs){
  const full = Object.assign({}, c);
  full.sourceIds = {};
  full.sourceIds[cs.id] = String(c.sourceId);
  if(!cs.detailEnabled) return full;
  const ds = cs.detailSelectors || {};
  const hasDetail = Object.keys(ds).some(k => ds[k]);
  if(!hasDetail || !c.sourceId || !/^https?:/i.test(c.sourceId)) return full;
  try{
    const text = await fetchSourceText(c.sourceId);
    const doc = new DOMParser().parseFromString(text, "text/html");
    const one = spec => cleanText(extractBySpec(doc, spec, false));
    const titleCn = one(ds.titleCn);
    if(titleCn) full.titleCn = titleCn;
    const titleOriginal = one(ds.titleOriginal);
    if(titleOriginal) full.titleOriginal = titleOriginal;
    const cover = String(extractBySpec(doc, ds.cover, false)).trim();
    if(cover){
      try{ full.coverUrl = new URL(cover, c.sourceId).href; }catch(e){}
    }
    const airDate = one(ds.airDate);
    if(airDate) full.airDate = validateDateInput(airDate) || airDate;
    const epsText = one(ds.totalEpisodes);
    if(epsText){
      const nm = epsText.match(/\d+/);
      if(nm) full.totalEpisodes = Number(nm[0]);
    }
    const summary = one(ds.summary);
    if(summary) full.summary = summary;
    const genres = extractBySpec(doc, ds.genres, true);
    if(genres.length) full.genres = genres.slice(0, 16);
    const studios = extractBySpec(doc, ds.studios, true);
    if(studios.length) full.studios = studios.slice(0, 6);
    const scoreText = one(ds.communityScore);
    if(scoreText){
      const nm = scoreText.match(/\d+(\.\d+)?/);
      if(nm){ const v = Number(nm[0]); if(v > 0 && v <= 10) full.communityScore = v; }
    }
  }catch(e){
    full._warn = "详情抓取失败，已用搜索结果的基础字段：" + describeFetchError(e);
  }
  return full;
}


/* ---- 预置模板（2026-10 实测定稿）----
   「国内的百度这些」的实测结论，如实记录：
   · 百度搜索/百度百科：裸请求分别 302 跳验证页 / 403 拦截，
     浏览器直连又被 CORS 拦 —— 两头堵死，无法做成可靠模板，不做。
   · 必应中国（cn.bing.com）：裸请求 200 + 服务端渲染完整结果，
     b_algo 结构多年稳定，搜片名常直出百科/B 站真实链接。无 ACAO → 需代理。
   · 萌娘百科（zh.moegirl.org.cn）：MediaWiki 标准搜索结构（实测 mw-search-result），
     ACG 资料最全；api.php 匿名调用被封但 HTML 搜索页可用。无 ACAO → 需代理。
   模板只是预填数据的快捷方式：用户点开仍可改、可试搜、可删。 */
const PRESET_CUSTOM_SOURCES = [
  {
    name: "必应中国（网页搜索）",
    searchUrl: "https://cn.bing.com/search?q={kw}&count=20",
    mode: "html",
    itemSelector: "#b_results li.b_algo",
    fields: { title: "h2 a", link: "h2 a@href", cover: "", meta: ".b_caption p" },
    detailEnabled: false,
    _presetNote: "国内可访问的通用网页搜索，搜片名常直出百科 / B 站番剧页的真实链接（不是跳转链）。实测 2026-10 结构稳定。需在上方配置 CORS 代理后使用。"
  },
  {
    name: "萌娘百科（ACG 百科）",
    searchUrl: "https://zh.moegirl.org.cn/index.php?search={kw}&fulltext=1",
    mode: "html",
    itemSelector: ".mw-search-result",
    fields: { title: ".mw-search-result-heading a", link: ".mw-search-result-heading a@href", cover: "", meta: ".searchresult" },
    detailEnabled: true,
    detailSelectors: {
      titleCn: "#firstHeading",
      summary: ".mw-parser-output p",
      cover: ".infobox img@src"
    },
    _presetNote: "ACG 资料最全的中文百科，搜索与词条页都是 MediaWiki 标准结构（实测 2026-10）。点搜索结果可再抓词条页补全中文名/简介/封面。需 CORS 代理。"
  }
];
