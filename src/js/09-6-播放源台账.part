/* ============================================================
   16.6 播放源台账（跨作品管理）
   ------------------------------------------------------------
   需求原话：「不好管理每部动画的播放源那些可以删，那些失效了等等」。
   逐部作品去看线路有两个问题：
     ① 失效是跨作品的公共事实。同一个站点挂掉时，
        库里可能有十几条线路一起失效，逐部去发现等于漏掉一半；
     ② 删除/停用是批量决策。「把检测不通的都清掉」
        在逐部视角下无法表达。

   所以这一层把 a.sources 摊平成全局台账：
     每一项是 { anime, source }，动它就是动那部作品的那条线路，
     不复制数据 —— 台账是视图，不是第二份存储。
   ============================================================ */

/* 摊平全局台账。只取自有线路（a.sources），
   不走 sourcesOf —— 后者会在无线路时回落到 settings.stream_url
   那条全局兜底，把一个作品算成有线路，而它其实没有可管理的线路。 */
function sourceLedger(){
  const rows = [];
  state.anime.forEach(a => {
    migrateSources(a);
    const list = Array.isArray(a.sources) ? a.sources : [];
    list.forEach(s => { if(s && s.url) rows.push({ anime:a, source:s }); });
  });
  return rows;
}
/* 线路的展示名：优先线路名，其次从网址推断站点，
   最后才退回「线路 N」—— 站点名比编号有用得多，
   台账里一屏十几条「线路 1/2/3」根本分不清谁是谁。 */
function sourceDisplayName(s){
  const n = String(s && s.name || "").trim();
  if(n && !/^线路\s*\d+$/.test(n)) return n;
  const host = hostOf(normalizeStreamURL(s && s.url) || String(s && s.url || ""));
  if(host) return n ? (n + " · " + host) : host;
  return n || "未命名线路";
}
/* 台账里一条线路的完整状态标签（徽标文案 + 语义色）。
   返回数组，因为「停用」与「未检测」可能同时成立。 */
function sourceFlags(row){
  const s = row.source;
  const out = [];
  /* 「使用中」只在**真能播**时才给。
     activeSourceOf 在一部作品全部线路都停用/失效时会退回第一条，
     那是为了不让 activeSourceId 悬空、详情页不至于显示不出线路。
     但拿它当「使用中」badge 就是骗人：那条线路实际播不了，
     用户会以为放着不管就能看。徽标描述的是播放器的真实选择，
     不是数据结构里的指针指向。 */
  const act = activeSourceOf(row.anime);
  if(act && act.id === s.id && sourceUsable(act)){
    out.push({ id:"active", text:"使用中", tone:"ok" });
  }
  if(s.enabled === false) out.push({ id:"disabled", text:"已停用", tone:"muted" });
  /* 搜索型单独一个徽标：它和「已停用/已失效」是完全不同的状态，
     混在一起的话用户会以为这条坏了、然后去点「恢复」。 */
  if(sourceIsSearch(s)) out.push({ id:"search", text:"搜索型", tone:"muted" });
  const h = normalizeHealth(s.health);
  if(h.state === "dead") out.push({ id:"dead", text:"已失效", tone:"err" });
  else if(h.state === "blocked") out.push({ id:"blocked", text:"访问被拒", tone:"warn" });
  else if(h.state === "alive") out.push({ id:"alive", text:"可达", tone:"ok" });
  else out.push({ id:"unknown", text:"未检测", tone:"muted" });
  return out;
}
/* 台账汇总。分成「健康度分布」而不是给一个总数：
   用户真正要回答的问题是「有多少条还能用」，不是「我存了多少条」。 */
function sourceLedgerStats(rows){
  const st = { total:rows.length, alive:0, dead:0, unknown:0, blocked:0,
               disabled:0, animeWith:0, animeWithout:0, stale:0 };
  const seen = new Set();
  state.anime.forEach(a => {
    const n = Array.isArray(a.sources) ? a.sources.filter(x => x && x.url).length : 0;
    if(n) st.animeWith++; else st.animeWithout++;
  });
  rows.forEach(r => {
    seen.add(r.anime.id);
    if(r.source.enabled === false) st.disabled++;
    const h = normalizeHealth(r.source.health);
    if(h.state === "dead") st.dead++;
    else if(h.state === "blocked") st.blocked++;
    else if(h.state === "alive") st.alive++;
    else st.unknown++;
  });
  return st;
}
/* 单条线路探测。
 *
 * 能力边界必须写在结果里，不能让界面替我吹：
 * 浏览器对第三方站点既读不到状态码也读不到正文，
 * `fetch` 抛错只说明「请求没能完成」，可能是 DNS 失败、
 * 也可能是对方拒绝跨域。唯一能确定的是
 * 「响应回来了没有」。所以只有这一种结论叫 alive，
 * 其余全部归入 blocked 并附上原因，绝不写「已失效」——
 * 失效是用户的判断，不是探测器的判断。 */
async function probeSource(row, opts){
  opts = opts || {};
  const url = normalizeStreamURL(row.source.url);
  if(!url) return { state:"blocked", at:nowIso(), detail:"网址不是有效的 http/https 地址" };
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), opts.timeout || 9000);
  try{
    /* mode:"no-cors" 是这里唯一可行的模式：
       跨域请求若用默认 cors，对面没有 CORS 头就会抛 TypeError，
       那是「浏览器不让读」而不是「网站挂了」，
       两种情况混在一起会让探测结果毫无价值。 */
    const res = await fetch(url, {
      method:"GET", mode:"no-cors", redirect:"follow",
      referrerPolicy:"no-referrer", signal:ctrl.signal, cache:"no-store"
    });
    /* no-cors 下的响应是不透明的：拿不到状态码，
       但「resolve 本身就是响应」已经是我们能拿到的最强证据。 */
    if(res && (res.type === "opaque" || res.status === 0 || res.ok)){
      return { state:"alive", at:nowIso(),
        detail:"服务器有响应（跨域限制下无法确认能否播放）" };
    }
    return { state:"blocked", at:nowIso(), detail:"HTTP " + (res ? res.status : "?") };
  }catch(e){
    const name = String(e && e.name || "");
    if(name === "AbortError") return { state:"blocked", at:nowIso(), detail:"9 秒内没有响应（网络不通或对方在限流）" };
    return { state:"blocked", at:nowIso(),
      detail:"请求未能完成：" + ((e && e.message) || name || "未知原因") };
  }finally{ clearTimeout(timer); }
}

/* ---- 台账写操作 ----
   全部统一走「改内存对象 → 落盘 → 返回成功与否」，
   且落盘刻意用 Repo.put 而不是 saveAnime：
   台账整理（改备注、标失效、清重复）不是用户编辑作品内容，
   用 saveAnime 会 touch() 把 updatedAt 刷成现在，
   于是「最近添加」排序会因为整理了一次线路而全库乱序。 */
async function persistAnimeQuiet(a){
  return await Repo.put("anime", a).then(() => true).catch(err => {
    toast("保存失败：" + (err && err.message || err), "err");
    return false;
  });
}
/* 更新一条线路的字段。changes 里出现 undefined 表示「不动这个键」，
   这样调用方不必先读一遍旧值，也不会误把未传的字段清空。 */
async function updateSource(row, changes){
  const s = row.source;
  Object.keys(changes).forEach(k => {
    if(changes[k] === undefined) return;
    if(k === "health"){ s.health = normalizeHealth(changes[k]); return; }
    s[k] = changes[k];
  });
  return await persistAnimeQuiet(row.anime);
}
/* 删除一条线路。删掉的可能正是当前线路，
   此时必须把 activeSourceId 让给剩下的第一条 ——
   留着悬空 id 的表现是详情页显示一个已不存在的线路名。 */
async function deleteSource(row){
  const a = row.anime, s = row.source;
  const name = sourceDisplayName(s);
  const before = a.sources.length;
  a.sources = a.sources.filter(x => x.id !== s.id);
  if(a.sources.length === before) return false;
  if(a.activeSourceId === s.id) a.activeSourceId = (a.sources[0] || {}).id || "";
  syncLegacyStreamFields(a);
  const ok = await persistAnimeQuiet(a);
  return ok ? { removed:name, left:a.sources.length } : null;
}
/* 旧字段 a.streamUrl/streamEp 要跟着当前线路走。
   详情页与待机屏仍有读它们的地方，不同步的话
   「删掉了正在用的那条」之后，页面上还挂着已删线路的集数。 */
function syncLegacyStreamFields(a){
  const nx = activeSourceOf(a);
  a.streamUrl = nx ? nx.url : "";
  a.streamEp = nx ? nx.ep : null;
  a.streamUrlAt = nx ? (nx.savedAt || nowIso()) : "";
}
/* 批量删除。返回逐条结果而不是一个布尔：
   界面要能说清「删了 3 条、2 条没删掉」，否则用户会以为全部成功。 */
async function deleteSources(rows){
  const okNames = [], failNames = [];
  for(const r of rows){
    const res = await deleteSource(r);
    if(res) okNames.push(res.removed); else failNames.push(sourceDisplayName(r.source));
  }
  return { removed:okNames, failed:failNames };
}
/* 同一作品内按「网址 + 集数」判重。
   addSourceFromInput 加新线路时已经拦过一次，
   这里防的是更早版本/导入数据带进来的重复。 */
function findDuplicateIn(a, url, ep){
  return (a.sources || []).find(s =>
    s.url === url && (s.ep == null || ep == null || s.ep === ep)) || null;
}
/* 同一部作品内按「网址 + 集数」判重。
   注意遍历的是**作品**而不是台账行：
   一部作品在台账里有几行，就会在外层被访问几次，
   若按行遍历再回头扫全作品线路，同一组重复会被报告 N 次 ——
   表现为「发现 2 条重复」，点去重却只删得掉 1 条。 */
function ledgerDuplicates(rows){
  const out = [];
  const seenAnime = new Set();
  (rows || []).forEach(r => {
    const a = r.anime;
    if(!a || seenAnime.has(a.id)) return;
    seenAnime.add(a.id);
    const seen = new Map();
    (a.sources || []).forEach(s => {
      if(!s || !s.url) return;
      /* kind 进 key：搜索型存的是站点首页，和同址的普通线路不是重复 ——
         用户明确选过「仍按普通线路保存」，去重不能把它当靶子删掉。 */
      const k = (s.kind === "search" ? "search|" : "") + s.url + "|" + (s.ep == null ? "" : s.ep);
      if(seen.has(k)) out.push({ anime:a, source:s, keepId:seen.get(k) });
      else seen.set(k, s.id);
    });
  });
  return out;
}
/* 标记失效 / 恢复。走「用户判断」通道：
   探测只能给「可达/不可达」，「这条彻底废了」是用户的结论。 */
async function markSourceDead(row, dead){
  return await updateSource(row, {
    health: dead
      ? { state:"dead", at:nowIso(), detail:"用户手动标记失效" }
      : { state:"unknown", at:"", detail:"" }
  });
}

/* 手动指定当前线路。
 *
 * 为什么要单独立一个函数，而不是直接写 a.activeSourceId = s.id：
 * activeSourceId 是「播放器当前会起播哪条」的指针，
 * 一旦它指向一条不可用的线路，activeSourceOf 会在全不可用时
 * 悄悄退回第一条 —— 用户手动指定的意图就被改掉了，还看不出来。
 * 所以显式指定时必须：
 *   ① 允许指向任意线路（含已停用的），因为「我就是要用这条」
 *      是用户的判断，不是算法的判断；
 *   ② 但立刻把旧字段同步过去，否则详情页/待机屏读的还是老地址；
 *   ③ 落盘走 persistAnimeQuiet —— 指定线路属于「整理线路」，
 *      不该把 updatedAt 刷成现在、把老作品顶到「最近添加」最前。
 * 返回 false 表示这条线路当前不可用，界面该给出提示而不是假装成功。 */
async function setActiveSource(row){
  const a = row && row.anime, s = row && row.source;
  if(!a || !s) return { ok:false, reason:"missing" };
  /* 搜索型不能被设为「使用中」：它播不了，
     设完徽标写着使用中、播放却跳过它，等于界面在骗人。 */
  if(sourceIsSearch(s)) return { ok:false, reason:"search_only", usable:false, source:s, anime:a };
  a.activeSourceId = s.id;
  syncLegacyStreamFields(a);
  const ok = await persistAnimeQuiet(a);
  return { ok:ok, usable:sourceUsable(s), source:s, anime:a };
}
/* 批量指定：同一部作品只认一条，被选中多条时取「选中的第一条」。
   静默取最后一条会让用户以为是自己选的那条在生效。 */
async function setActiveSources(rows){
  const done = [];
  const byAnime = new Map();
  (rows || []).forEach(r => {
    if(!r || !r.source) return;
    if(byAnime.has(r.anime.id)) return;
    byAnime.set(r.anime.id, r);
  });
  for(const r of byAnime.values()){
    const res = await setActiveSource(r);
    if(res.ok) done.push(r);
  }
  return done;
}
/* 外部播放器区。
 *
 * 数据归属（这是本轮最关键的改动）：
 *   原先存在 settings.stream_url —— 全局一份，于是「给 A 番粘的片源」
 *   会在打开 B 番时被当成 B 番的片源。用户的原话是「不用每次都输入
 *   这部番的链接」，全局一份在语义上根本满足不了。
 *   现在按作品存：a.sources（多线路）+ a.activeSourceId（当前用哪条），
 *   settings.stream_url 保留为「无作品时的临时片源」，不删以免旧数据失效。
 *
 * 集数记录的现实约束：B 站分 P 用 ?p=，YouTube 用 &start=（秒），
 * 两者无法统一换算。所以只做「用户自己声明看到第几集」的轻量记录，
 * 不假装能从播放进度反推 —— 那需要跨域读取播放器内部状态，做不到。
 */
/* streamURLOf 已删：无调用点也无测试引用，语义与 activeSourceOf(a).url 重复。 */

