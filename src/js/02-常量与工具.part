function ic(name, size){
  const d = ICONS[name] || "";
  const s = size || 16;
  return '<svg viewBox="0 0 24 24" width="' + s + '" height="' + s + '" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + "</svg>";
}

function hostOf(u){ try { return new URL(u).hostname; } catch(e){ return ""; } }

function normalizeStreamURL(u){
  const s = String(u || "").trim();
  if(!s) return "";
  if(/^javascript:/i.test(s)) return "";   // 绝不允许 javascript: 伪协议进 iframe
  const withProto = /^https?:\/\//i.test(s) ? s : ("https://" + s);
  try{
    const u2 = new URL(withProto);
    if(u2.protocol !== "http:" && u2.protocol !== "https:") return "";
    return u2.href;
  }catch(e){ return ""; }
}

/* 搜索网址模板拼接（添加新番的自定义数据源与播放源的「搜索型片源」共用） */
function encKW(kw){ return encodeURIComponent(String(kw || "").trim()); }

function buildSearchUrl(tpl, kw){
  const t = String(tpl || "").trim();
  if(!t) return "";
  const k = String(kw || "").trim();
  /* 空关键词也不能把字面量 {kw} 带出去 —— 那会打开一个必然无效的地址 */
  if(!k) return t.replace(/\{kw\}/g, "");
  return t.indexOf("{kw}") >= 0 ? t.replace(/\{kw\}/g, encKW(k)) : t + encKW(k);
}

function validateDateInput(v){
  const s = String(v || "").trim();
  if(!s) return "";
  /* 常见手写格式先归一成 YYYY-MM-DD（/ YYYY-MM）：2001-4-5、2001/4/5、
     2001年4月5日 都是用户会输入的。以前这些一律判非法静默清空，
     从外部数据带进来的短格式还会在编辑一次后被抹掉。 */
  const m = /^(\d{4})[年./\-](\d{1,2})(?:[月./\-](\d{1,2})日?)?$/.exec(s);
  if(m){
    const mo = Number(m[2]), day = m[3] ? Number(m[3]) : null;
    if(mo >= 1 && mo <= 12 && (day == null || (day >= 1 && day <= 31))){
      const p = n => String(n).padStart(2,"0");
      return m[1] + "-" + p(mo) + (day == null ? "" : "-" + p(day));
    }
    return "";
  }
  if(!parseDateOnly(s)) return "";
  return s;
}
