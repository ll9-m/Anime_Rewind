async function ensureBuiltinQuotes(restore){
  let added = 0;
  for(let i = 0; i < BUILTIN_QUOTES.length; i++){
    const [text, src, who] = BUILTIN_QUOTES[i];
    const norm = normalize(text);
    const exists = state.quotes.find(q => normalize(q.text) === norm);
    if(exists){
      if(restore && !exists.isBuiltin){ exists.isBuiltin = true; await saveQuote(exists); }
      continue;
    }
    await saveQuote({ id:"bq_" + i, text, sourceAnimeTitle:src, character:who, isBuiltin:true, favorite:false, schemaVersion:SCHEMA_VERSION, createdAt:new Date().toISOString() });
    added++;
  }
  return added;
}
function quotePool(){ return state.quotes.filter(q => q.text && q.text.trim()); }
function pickRandom(arr){
  if(!arr.length) return null;
  return arr[Math.floor(Math.random() * arr.length)];
}
function pickRandomQuote(exclude){
  const pool = quotePool();
  if(!pool.length) return null;
  if(pool.length === 1) return pool[0];
  let q = pickRandom(pool), guard = 0;
  while(exclude && q && q.id === exclude.id && guard++ < 12) q = pickRandom(pool);
  return q;
}
function quoteMetaLine(q){
  return "—— " + (q.character ? q.character + " · " : "") + q.sourceAnimeTitle;
}

